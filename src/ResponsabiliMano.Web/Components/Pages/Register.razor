@page "/register"
@attribute [AllowAnonymous]
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>@Localizer["RegisterTitle"]</PageTitle>

<div class="rm-auth">
    <div class="rm-auth-brand">
        <div class="rm-auth-wordmark">Responsabili<span class="accent">Mano</span></div>
        <div class="rm-auth-tagline">@Localizer["AuthTagline"]</div>
    </div>

    <div class="rm-auth-card">
        <h3>@Localizer["RegisterTitle"]</h3>

        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="alert-danger" role="alert">@Localizer["RegisterError"]</div>
        }

        <form method="post" action="/api/auth/register-and-login">
            <div class="rm-field">
                <label for="name" class="rm-label">@Localizer["NameLabel"]</label>
                <input id="name" name="Name" class="rm-input" required maxlength="200" autocomplete="name" />
            </div>

            <div class="rm-field">
                <label for="email" class="rm-label">@Localizer["EmailLabel"]</label>
                <input id="email" name="Email" type="email" class="rm-input" required autocomplete="email" />
            </div>

            <div class="rm-field">
                <label for="password" class="rm-label">@Localizer["PasswordLabel"]</label>
                <input id="password" name="Password" type="password" class="rm-input" required minlength="8" autocomplete="new-password" />
            </div>

            <div class="rm-field">
                <label for="confirmPassword" class="rm-label">@Localizer["ConfirmPasswordLabel"]</label>
                <input id="confirmPassword" name="ConfirmPassword" type="password" class="rm-input" required minlength="8" autocomplete="new-password" />
            </div>

            <button type="submit" class="rm-btn">@Localizer["RegisterButton"]</button>
        </form>
    </div>

    <div class="rm-auth-links">
        <p>@Localizer["AlreadyHaveAccount"] <a href="/login">@Localizer["LoginButton"]</a></p>
    </div>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? Error { get; set; }
}
