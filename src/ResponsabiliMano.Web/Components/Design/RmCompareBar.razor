@* Two bars sharing a 0..100 progress scale, one per half of the duo. The leader's
   value is tinted so the comparison reads without hunting for the longer bar. *@

<div class="rm-compare @Class">
    <div class="rm-compare__row">
        <div class="rm-compare__track">
            <div class="rm-compare__fill rm-compare__fill--you" style="width: @BarWidth(YouProgress)%"></div>
        </div>
        <span class="rm-compare__value @(YouLeads ? "rm-you-text" : null)">@Format(YouValue)</span>
    </div>
    <div class="rm-compare__row">
        <div class="rm-compare__track">
            <div class="rm-compare__fill rm-compare__fill--partner" style="width: @BarWidth(PartnerProgress)%"></div>
        </div>
        <span class="rm-compare__value @(!YouLeads ? "rm-partner-text" : null)">@Format(PartnerValue)</span>
    </div>
</div>

@code {
    [Parameter]
    public decimal? YouProgress { get; set; }

    [Parameter]
    public decimal? PartnerProgress { get; set; }

    [Parameter]
    public decimal? YouValue { get; set; }

    [Parameter]
    public decimal? PartnerValue { get; set; }

    /// <summary>Appended to both values, e.g. "kg" or "%".</summary>
    [Parameter]
    public string? Unit { get; set; }

    [Parameter]
    public string? Class { get; set; }

    private bool YouLeads => (YouProgress ?? 0m) >= (PartnerProgress ?? 0m);

    private string BarWidth(decimal? progress) =>
        DecimalInput.ToInvariant(Math.Clamp(progress ?? 0m, 0m, 100m));

    private string Format(decimal? value) =>
        value is { } present ? $"{DecimalInput.ToDisplay(present)}{Unit}" : "—";
}
