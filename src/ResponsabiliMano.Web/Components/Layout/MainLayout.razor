@* App shell. Sidebar from 1024px up; sticky header plus bottom nav below that. *@

@inherits LayoutComponentBase
@inject IStringLocalizer<AppStrings> Localizer

<div class="shell">
    <aside class="shell__sidebar">
        <a href="/projects" class="shell__brand"><RmLogo /></a>
        <NavMenu />
        <RmThemeToggle Class="shell__theme" Label="@Localizer["ThemeLabel"]"
                       LightLabel="@Localizer["ThemeLight"]"
                       DarkLabel="@Localizer["ThemeDark"]"
                       SystemLabel="@Localizer["ThemeSystem"]" />
    </aside>

    <header class="shell__topbar">
        <a href="/projects" class="shell__brand"><RmLogo /></a>
        <div class="shell__topbar-actions">
            <RmThemeToggle Label="@Localizer["ThemeLabel"]"
                           LightLabel="@Localizer["ThemeLight"]"
                           DarkLabel="@Localizer["ThemeDark"]"
                           SystemLabel="@Localizer["ThemeSystem"]" />
            <AuthorizeView>
                <Authorized>
                    <RmAvatar Name="@context.User.Identity?.Name" Tone="neutral" Size="sm" />
                </Authorized>
            </AuthorizeView>
        </div>
    </header>

    <main class="shell__main">
        <div class="rm-page">
            @Body
        </div>
    </main>

    <BottomNav />
</div>

<div id="blazor-error-ui" data-nosnippet>
    @Localizer["BlazorErrorMessage"]
    <a href="." class="reload">@Localizer["Reload"]</a>
    <span class="dismiss">🗙</span>
</div>
