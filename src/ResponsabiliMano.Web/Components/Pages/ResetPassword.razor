@page "/reset-password"
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@layout AuthLayout
@inject IPasswordResetService ResetService
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> Localizer
@inject ILogger<ResetPassword> Logger

<PageTitle>@Localizer["ResetPasswordTitle"]</PageTitle>

<div>
    <h1 class="auth-form__title">@Localizer["ResetPasswordTitle"]</h1>
    <p class="auth-form__subtitle">@Localizer["ResetPasswordSubtitle"]</p>

    @if (_success)
    {
        <RmAlert Tone="success" Class="auth-form__alert">@Localizer["ResetPasswordSuccess"]</RmAlert>
    }
    else
    {
        <EditForm Model="_model" OnValidSubmit="HandleSubmit" FormName="resetPasswordForm" class="auth-form">
            <DataAnnotationsValidator />

            <RmField Label="@Localizer["NewPasswordLabel"]" For="password">
                <InputText id="password" type="password" class="rm-input" @bind-Value="_model.Password" />
                <ValidationMessage For="@(() => _model.Password)" />
            </RmField>

            <RmField Label="@Localizer["ConfirmPasswordLabel"]" For="confirmPassword">
                <InputText id="confirmPassword" type="password" class="rm-input" @bind-Value="_model.ConfirmPassword" />
                <ValidationMessage For="@(() => _model.ConfirmPassword)" />
            </RmField>

            @if (!string.IsNullOrEmpty(_error))
            {
                <RmAlert Tone="danger">@_error</RmAlert>
            }

            <button type="submit" class="rm-btn rm-btn--primary rm-btn--block" disabled="@_isLoading">
                @(_isLoading ? Localizer["Resetting"] : Localizer["ResetPasswordButton"])
            </button>
        </EditForm>
    }

    <p class="auth-form__footer">
        <a href="/login" class="auth-form__link">@Localizer["BackToLogin"]</a>
    </p>
</div>

@code {
    private ResetPasswordRequest _model = new();
    private string? _error;
    private bool _isLoading;
    private bool _success;

    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(Token))
        {
            _model.Token = Token;
        }
    }

    private async Task HandleSubmit()
    {
        _isLoading = true;
        _error = null;

        try
        {
            var result = await ResetService.ResetPasswordAsync(_model.Token, _model.Password);
            if (result)
            {
                _success = true;
            }
            else
            {
                _error = Localizer["ResetPasswordInvalidToken"];
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to reset password");
            _error = Localizer["ResetPasswordError"];
        }
        finally
        {
            _isLoading = false;
        }
    }
}
