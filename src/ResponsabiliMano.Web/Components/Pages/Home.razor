@page "/projects"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IStringLocalizer<AppStrings> Localizer
@inject IProjectService ProjectService
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<Home> Logger

<PageTitle>@Localizer["HomeTitle"]</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="projects__head">
            <div>
                <h1 class="projects__title">@Localizer["MyProjectsTitle"]</h1>
                <p class="projects__subtitle">@Localizer["HomeSubtitle"]</p>
            </div>
            <RmButton Href="/projects/new" Class="projects__new">
                <RmIcon Name="plus" />
                @Localizer["NavCreateProject"]
            </RmButton>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <RmAlert Tone="danger" Class="mb-3">@_error</RmAlert>
        }

        @if (_loading)
        {
            <div class="projects__list">
                <div class="skeleton projects__skeleton"></div>
                <div class="skeleton projects__skeleton"></div>
            </div>
        }
        else if (_projects.Count == 0)
        {
            <RmEmptyState Icon="folder"
                          Title="@Localizer["HomeEmptyTitle"]"
                          Description="@Localizer["HomeEmptyDescription"]">
                <RmButton Href="/projects/new">@Localizer["HomeEmptyButton"]</RmButton>
            </RmEmptyState>
        }
        else
        {
            <div class="projects__list">
                @foreach (var project in _projects)
                {
                    <a class="rm-card rm-card--interactive project" href="@($"/projects/{project.Id}")">
                        <span class="rm-icon-tile rm-icon-tile--lg project__icon">@(project.Icon ?? "🎯")</span>

                        <div class="project__body">
                            <div class="project__heading">
                                <h2 class="project__name">@project.Name</h2>
                                <RmBadge Tone="@StatusTone(project.Status)" Dot="true">@StatusText(project.Status)</RmBadge>
                            </div>
                            <div class="project__meta">
                                <span><RmIcon Name="calendar" Size="0.875rem" /> @Localizer["ProjectUntil", project.EndDate.ToString("dd MMM yyyy")]</span>
                                <span><RmIcon Name="target" Size="0.875rem" /> @Localizer["ProjectGoalCount", project.Goals.Count]</span>
                            </div>
                        </div>

                        <div class="project__side">
                            <RmAvatarStack You="@project.Creator?.Name" Partner="@project.Partner?.Name" />
                            <RmIcon Name="chevron-right" Class="project__chevron" />
                        </div>
                    </a>
                }
            </div>

            <a class="rm-card rm-card--interactive rm-card--dashed projects__create" href="/projects/new">
                <RmIconTile>
                    <RmIcon Name="plus" Size="1.25rem" />
                </RmIconTile>
                <p class="projects__create-title">@Localizer["HomeCreateAnotherTitle"]</p>
                <p class="projects__create-text">@Localizer["HomeCreateAnotherText"]</p>
            </a>
        }

        <AutoRefresh IntervalSeconds="5" OnRefresh="RefreshAsync" />
    </Authorized>
</AuthorizeView>

@code {
    private List<Core.Entities.Project> _projects = new();
    private Guid _currentUserId;
    private string? _error;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdStr = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (userIdStr is not null && Guid.TryParse(userIdStr, out _currentUserId))
        {
            try
            {
                _projects = await ProjectService.GetUserProjectsAsync(_currentUserId);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to load projects for user {UserId}", _currentUserId);
                _error = Localizer["HomeLoadError"];
            }
        }

        _loading = false;
    }

    // Live updates (spec RT2): re-query on a timer and re-render only when the set of
    // projects (id/status/name) actually changed, so a partner joining or a status
    // flip shows up without a manual reload.
    private async Task RefreshAsync()
    {
        if (_currentUserId == Guid.Empty)
            return;

        try
        {
            var latest = await ProjectService.GetUserProjectsAsync(_currentUserId);
            if (ProjectsSignature(latest) != ProjectsSignature(_projects))
            {
                _projects = latest;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to refresh projects for user {UserId}", _currentUserId);
        }
    }

    private static string ProjectsSignature(IEnumerable<Core.Entities.Project> projects) =>
        string.Join("|", projects.Select(p => $"{p.Id}:{p.Status}:{p.Name}"));

    private static string StatusTone(Core.Enums.ProjectStatus status) => status switch
    {
        Core.Enums.ProjectStatus.Active => "primary",
        Core.Enums.ProjectStatus.Pending => "partner",
        Core.Enums.ProjectStatus.Cancelled => "destructive",
        _ => "muted"
    };

    private string StatusText(Core.Enums.ProjectStatus status) => status switch
    {
        Core.Enums.ProjectStatus.Pending => Localizer["StatusPending"],
        Core.Enums.ProjectStatus.Active => Localizer["StatusActive"],
        Core.Enums.ProjectStatus.Finished => Localizer["StatusFinished"],
        Core.Enums.ProjectStatus.Cancelled => Localizer["StatusCancelled"],
        _ => status.ToString()
    };
}
