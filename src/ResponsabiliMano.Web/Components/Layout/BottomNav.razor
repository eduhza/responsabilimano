@* Mobile navigation. Mirrors the sidebar, with the primary action raised into a
   centre FAB the way the reference design does. *@

@inject IStringLocalizer<AppStrings> Localizer
@inject IFeatureManager FeatureManager
@using Microsoft.FeatureManagement

<nav class="bottom-nav">
    <div class="bottom-nav__inner">
        <AuthorizeView>
            <Authorized>
                @if (_dashboardEnabled)
                {
                    <NavLink href="/dashboard" class="bottom-nav__item">
                        <RmIcon Name="layout-dashboard" Size="1.25rem" />
                        <span>@Localizer["NavDashboard"]</span>
                    </NavLink>
                }

                <NavLink href="/projects" Match="NavLinkMatch.All" class="bottom-nav__item">
                    <RmIcon Name="folder" Size="1.25rem" />
                    <span>@Localizer["NavProjects"]</span>
                </NavLink>

                <div class="bottom-nav__fab">
                    <RmButton Href="/projects/new" IconOnly="true" aria-label="@Localizer["NavCreateProject"]">
                        <RmIcon Name="plus" Size="1.25rem" />
                    </RmButton>
                </div>

                @if (_checkInsEnabled)
                {
                    <NavLink href="/checkin" class="bottom-nav__item">
                        <RmIcon Name="clipboard-check" Size="1.25rem" />
                        <span>@Localizer["NavCheckIn"]</span>
                    </NavLink>
                }

                <NavLink href="/profile" class="bottom-nav__item">
                    <RmIcon Name="user" Size="1.25rem" />
                    <span>@Localizer["NavProfile"]</span>
                </NavLink>
            </Authorized>
            <NotAuthorized>
                <NavLink href="/" Match="NavLinkMatch.All" class="bottom-nav__item">
                    <RmIcon Name="folder" Size="1.25rem" />
                    <span>@Localizer["NavHome"]</span>
                </NavLink>

                <NavLink href="/login" class="bottom-nav__item">
                    <RmIcon Name="arrow-right" Size="1.25rem" />
                    <span>@Localizer["LoginButton"]</span>
                </NavLink>

                <NavLink href="/register" class="bottom-nav__item">
                    <RmIcon Name="user" Size="1.25rem" />
                    <span>@Localizer["RegisterButton"]</span>
                </NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</nav>

@code {
    private bool _dashboardEnabled;
    private bool _checkInsEnabled;

    protected override async Task OnInitializedAsync()
    {
        _dashboardEnabled = await FeatureManager.IsEnabledAsync(FeatureFlags.Dashboard);
        _checkInsEnabled = await FeatureManager.IsEnabledAsync(FeatureFlags.CheckIns);
    }
}
