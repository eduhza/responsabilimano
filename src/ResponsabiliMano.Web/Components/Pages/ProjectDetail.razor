@page "/projects/{ProjectId:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IProjectService ProjectService
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> Localizer
@inject AuthenticationStateProvider AuthStateProvider
@inject IFeatureManager FeatureManager
@inject ILogger<ProjectDetail> Logger
@using Microsoft.FeatureManagement

<PageTitle>@Localizer["ProjectDetailTitle"]</PageTitle>

@if (_loading)
{
    <div class="skeleton" style="width: 60%; height: 2rem; margin-bottom: 1.5rem;"></div>
    <div class="skeleton" style="width: 100%; height: 6rem; margin-bottom: 1.5rem;"></div>
    <div class="skeleton" style="width: 100%; height: 8rem; margin-bottom: 1.5rem;"></div>
    <div class="skeleton" style="width: 100%; height: 4rem;"></div>
}
else if (_project is null)
{
    <FluentMessageBar Intent="MessageIntent.Error" Title="@Localizer["ProjectNotFound"]" AllowDismiss="false" />
    <FluentButton Appearance="Appearance.Neutral" OnClick="@(() => Navigation.NavigateTo("/"))" Class="mt-3">
        @Localizer["BackToHome"]
    </FluentButton>
}
else
{
    <AutoRefresh IntervalSeconds="5" OnRefresh="RefreshAsync" />

    <div class="detail-head">
        <h1 class="detail-title">@_project.Name</h1>
        <span class="status-pill" style="--status-color: @StatusColor(_project.Status);">@GetStatusText(_project.Status)</span>
    </div>

    @if (_project.Status == Core.Enums.ProjectStatus.Active)
    {
        <StreakIndicator CurrentStreak="_streak.Current" BestStreak="_streak.Best" />
    }

    <div class="rm-meta">
        <div class="rm-meta-item">
            <span class="rm-meta-label">@Localizer["StartDateLabel"]</span>
            <span class="rm-meta-value">@_project.StartDate.ToString("dd/MM/yyyy")</span>
        </div>
        <div class="rm-meta-item">
            <span class="rm-meta-label">@Localizer["EndDateLabel"]</span>
            <span class="rm-meta-value">@_project.EndDate.ToString("dd/MM/yyyy")</span>
        </div>
        <div class="rm-meta-item">
            <span class="rm-meta-label">@Localizer["FrequencyLabel"]</span>
            <span class="rm-meta-value">@GetFrequencyText(_project.Frequency)</span>
        </div>
        <div class="rm-meta-item">
            <span class="rm-meta-label">@Localizer["CreatorLabel"]</span>
            <span class="rm-meta-value">@_project.Creator?.Name</span>
        </div>
        <div class="rm-meta-item">
            <span class="rm-meta-label">@Localizer["PartnerLabel"]</span>
            @if (_project.Partner is not null)
            {
                <span class="rm-meta-value">@_project.Partner.Name</span>
            }
            else
            {
                <span class="rm-meta-value text-muted">@Localizer["NoPartnerYet"]</span>
            }
        </div>
    </div>

    @if (_project.Partner is null && _project.CreatorId == _currentUserId)
    {
        <FluentAnchor Href="@($"/projects/{_project.Id}/invite")" Appearance="Appearance.Accent" Class="mb-3">
            @Localizer["InvitePartnerButton"]
        </FluentAnchor>
    }

    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Style="margin-bottom: 1.5rem;" VerticalGap="8">
        @if (_project.Status == Core.Enums.ProjectStatus.Active && _checkInsEnabled)
        {
            <FluentAnchor Href="@($"/projects/{_project.Id}/checkin")" Appearance="Appearance.Accent">
                @Localizer["CheckInButton"]
            </FluentAnchor>
        }

        @if (_project.Status == Core.Enums.ProjectStatus.Active && _dashboardEnabled)
        {
            <FluentAnchor Href="@($"/projects/{_project.Id}/dashboard")" Appearance="Appearance.Outline">
                @Localizer["DashboardButton"]
            </FluentAnchor>
        }
    </FluentStack>

    <h4 class="rm-section-title">@Localizer["GoalsSectionTitle"]</h4>
    <div class="goal-list">
        @foreach (var goal in _project.Goals)
        {
            <div class="goal-tile">
                <p class="goal-tile-label">@goal.Label</p>
                <div class="goal-tile-target">
                    @(goal.TargetValue?.ToString() ?? "—")<span class="unit"> @goal.Unit</span>
                </div>
                @if (goal.MinValue is not null || goal.MaxValue is not null)
                {
                    <div class="goal-tile-range">@goal.MinValue … @goal.MaxValue @goal.Unit</div>
                }
            </div>
        }
    </div>

    @if (_project.Status == Core.Enums.ProjectStatus.Pending && _project.PartnerId is not null)
    {
        <FluentCard Class="mb-3">
            <h5 style="margin-top: 0;">@Localizer["ApproveProjectTitle"]</h5>
            <p>@Localizer["ApproveProjectDescription"]</p>
            <FluentButton Appearance="Appearance.Accent" Disabled="@_actionLoading" Loading="@_actionLoading" OnClick="HandleApproveProject">
                @Localizer["ApproveButton"]
            </FluentButton>
        </FluentCard>
    }

    <h4 class="rm-section-title">@Localizer["ChangeRequestsTitle"]</h4>
    @if (_project.ChangeRequests.Count == 0)
    {
        <div class="empty-state" style="padding: 1rem;">
            <span class="text-muted">@Localizer["NoChangeRequests"]</span>
        </div>
    }
    else
    {
        <div class="cr-list">
            @foreach (var cr in _project.ChangeRequests.OrderByDescending(c => c.CreatedAt))
            {
                <div class="cr-card">
                    <div class="cr-card-main">
                        <span class="cr-card-type">@GetChangeRequestTypeText(cr.Type)</span>
                        <span class="cr-card-meta">
                            @(cr.RequestedByUserId == _project.CreatorId ? _project.Creator?.Name : _project.Partner?.Name)
                            · @cr.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </span>
                    </div>
                    <span class="cr-badge @CrBadgeClass(cr.Status)">@GetChangeRequestStatusText(cr.Status)</span>
                    @if (cr.Status == Core.Enums.ChangeRequestStatus.Pending && cr.RequestedByUserId != _currentUserId)
                    {
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8">
                            <FluentButton Appearance="Appearance.Accent" Disabled="@_actionLoading" OnClick="@(() => HandleRespondToChangeRequest(cr.Id, true))">
                                @Localizer["ApproveButton"]
                            </FluentButton>
                            <FluentButton Appearance="Appearance.Outline" Disabled="@_actionLoading" OnClick="@(() => HandleRespondToChangeRequest(cr.Id, false))">
                                @Localizer["RejectButton"]
                            </FluentButton>
                        </FluentStack>
                    }
                </div>
            }
        </div>
    }

    @if (_project.Status is Core.Enums.ProjectStatus.Pending or Core.Enums.ProjectStatus.Active)
    {
        <FluentCard Class="mb-3">
            <h5 style="margin-top: 0;">@Localizer["ProposeChangeTitle"]</h5>

            <FluentSelect TOption="string"
                          Label="@Localizer["ChangeTypeLabel"]"
                          Appearance="Appearance.Outline"
                          Value="_proposeType.ToString()"
                          ValueChanged="@(v => _proposeType = Enum.Parse<ChangeRequestType>(v ?? string.Empty))"
                          Style="width: 100%; max-width: 300px; margin-bottom: 0.75rem;">
                <FluentOption Value="@ChangeRequestType.EndDate.ToString()">@Localizer["ChangeTypeEndDate"]</FluentOption>
                <FluentOption Value="@ChangeRequestType.Frequency.ToString()">@Localizer["ChangeTypeFrequency"]</FluentOption>
                <FluentOption Value="@ChangeRequestType.Goals.ToString()">@Localizer["ChangeTypeGoals"]</FluentOption>
            </FluentSelect>

            @if (_proposeType == Core.Enums.ChangeRequestType.EndDate)
            {
                <FluentDatePicker Label="@Localizer["NewEndDateLabel"]"
                                  Value="_proposeEndDate"
                                  ValueChanged="@(v => _proposeEndDate = v)"
                                  Style="width: 100%; max-width: 300px;" />
            }
            else if (_proposeType == Core.Enums.ChangeRequestType.Frequency)
            {
                <FluentSelect TOption="string"
                              Label="@Localizer["NewFrequencyLabel"]"
                              Appearance="Appearance.Outline"
                              Value="_proposeFrequency.ToString()"
                              ValueChanged="@(v => _proposeFrequency = Enum.Parse<ProjectFrequency>(v ?? string.Empty))"
                              Style="width: 100%; max-width: 300px;">
                    <FluentOption Value="@ProjectFrequency.Daily.ToString()">@Localizer["FrequencyDaily"]</FluentOption>
                    <FluentOption Value="@ProjectFrequency.Weekly.ToString()">@Localizer["FrequencyWeekly"]</FluentOption>
                    <FluentOption Value="@ProjectFrequency.Biweekly.ToString()">@Localizer["FrequencyBiweekly"]</FluentOption>
                    <FluentOption Value="@ProjectFrequency.Monthly.ToString()">@Localizer["FrequencyMonthly"]</FluentOption>
                </FluentSelect>
            }
            else if (_proposeType == Core.Enums.ChangeRequestType.Goals)
            {
                @for (var i = 0; i < _proposeGoals.Count; i++)
                {
                    var index = i;
                    <FluentCard Class="mb-2 goal-card">
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Style="flex-wrap: wrap; margin-bottom: 0.75rem;">
                            <div style="flex: 2; min-width: 200px;">
                                <FluentTextField Label="@Localizer["GoalFieldLabel"]"
                                                 Appearance="FluentInputAppearance.Outline"
                                                 @bind-Value="_proposeGoals[index].Label"
                                                 Style="width: 100%;" />
                            </div>
                            <div style="flex: 1; min-width: 150px;">
                                <FluentSelect TOption="string"
                                              Label="@Localizer["GoalDataTypeLabel"]"
                                              Appearance="Appearance.Outline"
                                              Value="_proposeGoals[index].DataType.ToString()"
                                              ValueChanged="@(v => _proposeGoals[index].DataType = Enum.Parse<GoalDataType>(v ?? string.Empty))"
                                              Style="width: 100%;">
                                    <FluentOption Value="@GoalDataType.Decimal.ToString()">@Localizer["DataTypeDecimal"]</FluentOption>
                                    <FluentOption Value="@GoalDataType.Integer.ToString()">@Localizer["DataTypeInteger"]</FluentOption>
                                    <FluentOption Value="@GoalDataType.Percent.ToString()">@Localizer["DataTypePercent"]</FluentOption>
                                </FluentSelect>
                            </div>
                            <div style="flex: 1; min-width: 100px;">
                                <FluentTextField Label="@Localizer["GoalUnitLabel"]"
                                                 Appearance="FluentInputAppearance.Outline"
                                                 @bind-Value="_proposeGoals[index].Unit"
                                                 Style="width: 100%;" />
                            </div>
                        </FluentStack>

                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Style="flex-wrap: wrap;">
                            <div style="flex: 1; min-width: 120px;">
                                <FluentNumberField TValue="decimal?"
                                                   Label="@Localizer["GoalMinValueLabel"]"
                                                   Appearance="FluentInputAppearance.Outline"
                                                   HideStep="true"
                                                   @bind-Value="_proposeGoals[index].MinValue"
                                                   Style="width: 100%;" />
                            </div>
                            <div style="flex: 1; min-width: 120px;">
                                <FluentNumberField TValue="decimal?"
                                                   Label="@Localizer["GoalMaxValueLabel"]"
                                                   Appearance="FluentInputAppearance.Outline"
                                                   HideStep="true"
                                                   @bind-Value="_proposeGoals[index].MaxValue"
                                                   Style="width: 100%;" />
                            </div>
                            <div style="flex: 1; min-width: 120px;">
                                <FluentNumberField TValue="decimal?"
                                                   Label="@Localizer["GoalTargetValueLabel"]"
                                                   Appearance="FluentInputAppearance.Outline"
                                                   HideStep="true"
                                                   @bind-Value="_proposeGoals[index].TargetValue"
                                                   Style="width: 100%;" />
                            </div>
                        </FluentStack>
                    </FluentCard>
                }

                <FluentButton Type="ButtonType.Button"
                              Appearance="Appearance.Outline"
                              IconStart="@(new Icons.Regular.Size20.Add())"
                              OnClick="AddProposeGoal"
                              Class="mb-2">
                    @Localizer["AddGoalButton"]
                </FluentButton>
            }

            @if (!string.IsNullOrEmpty(_proposeError))
            {
                <FluentMessageBar Intent="MessageIntent.Error" Title="@_proposeError" AllowDismiss="false" Class="mt-2" />
            }

            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Class="mt-3">
                <FluentButton Type="ButtonType.Button" Appearance="Appearance.Accent" Disabled="@_actionLoading" Loading="@_actionLoading" OnClick="HandleProposeChange">
                    @(_actionLoading ? Localizer["Processing"] : Localizer["ProposeChangeButton"])
                </FluentButton>
            </FluentStack>
        </FluentCard>
    }

    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <FluentMessageBar Intent="@_statusMessageIntent" Title="@_statusMessage" AllowDismiss="false" Class="mb-3" />
    }

    <FluentButton Appearance="Appearance.Neutral" OnClick="@(() => Navigation.NavigateTo("/"))">
        @Localizer["BackToHome"]
    </FluentButton>
}

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    private Core.Entities.Project? _project;
    private Guid _currentUserId;
    private bool _loading = true;
    private bool _checkInsEnabled;
    private bool _dashboardEnabled;
    private bool _actionLoading;
    private string? _statusMessage;
    private MessageIntent _statusMessageIntent = MessageIntent.Info;
    private string? _proposeError;
    private (int Current, int Best) _streak;

    private Core.Enums.ChangeRequestType _proposeType = Core.Enums.ChangeRequestType.EndDate;
    private DateTime? _proposeEndDate;
    private Core.Enums.ProjectFrequency _proposeFrequency = Core.Enums.ProjectFrequency.Weekly;
    private List<GoalFieldRequest> _proposeGoals = new();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _checkInsEnabled = await FeatureManager.IsEnabledAsync(FeatureFlags.CheckIns);
        _dashboardEnabled = await FeatureManager.IsEnabledAsync(FeatureFlags.Dashboard);
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdStr = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (userIdStr is null || !Guid.TryParse(userIdStr, out _currentUserId))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            _project = await ProjectService.GetProjectAsync(ProjectId, _currentUserId);
            if (_project is not null)
            {
                _proposeEndDate = _project.EndDate;
                _proposeFrequency = _project.Frequency;
                _proposeGoals = _project.Goals.Select(g => new GoalFieldRequest
                {
                    Label = g.Label,
                    DataType = g.DataType,
                    Unit = g.Unit,
                    MinValue = g.MinValue,
                    MaxValue = g.MaxValue,
                    TargetValue = g.TargetValue
                }).ToList();

                if (_project.Status == Core.Enums.ProjectStatus.Active)
                {
                    _streak = await ProjectService.GetStreakAsync(ProjectId, _currentUserId);
                }
            }
        }
        catch (UnauthorizedAccessException)
        {
            _project = null;
        }
        finally
        {
            _loading = false;
        }
    }

    // Live updates (spec RT2): re-query on a timer and refresh only the display-side
    // state (status, partner, goals, change requests, streak) when the project's
    // signature changes. Deliberately does NOT touch the propose-change form fields
    // (_proposeType/_proposeEndDate/_proposeFrequency/_proposeGoals) so a partner's
    // action never wipes what the user is typing.
    private async Task RefreshAsync()
    {
        if (_project is null || _actionLoading)
            return;

        try
        {
            var latest = await ProjectService.GetProjectAsync(ProjectId, _currentUserId);
            if (latest is null || ProjectSignature(latest) == ProjectSignature(_project))
                return;

            _project = latest;
            if (latest.Status == Core.Enums.ProjectStatus.Active)
                _streak = await ProjectService.GetStreakAsync(ProjectId, _currentUserId);

            StateHasChanged();
        }
        catch (UnauthorizedAccessException)
        {
            // Participation changed under us; ignore on a background poll.
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to refresh project {ProjectId}", ProjectId);
        }
    }

    private static string ProjectSignature(Core.Entities.Project p) =>
        $"{p.Status}|{p.PartnerId}|{p.Partner?.Name}|{p.EndDate:O}|{p.Frequency}|" +
        string.Join(",", p.Goals.OrderBy(g => g.Id).Select(g => $"{g.Id}:{g.Label}:{g.TargetValue}")) + "|" +
        string.Join(",", p.ChangeRequests.OrderBy(c => c.Id).Select(c => $"{c.Id}:{c.Status}"));

    private void AddProposeGoal()
    {
        _proposeGoals.Add(new GoalFieldRequest());
    }

    private async Task HandleApproveProject()
    {
        var dialog = await DialogService.ShowConfirmationAsync(
            @Localizer["ApproveProjectDescription"],
            primaryText: @Localizer["ApproveButton"],
            secondaryText: @Localizer["Cancel"],
            title: @Localizer["ConfirmApproveTitle"]);

        var result = await dialog.Result;
        if (result.Cancelled)
            return;

        await ExecuteAction(async () =>
        {
            await ProjectService.ApproveProjectAsync(ProjectId, _currentUserId);
            _statusMessage = Localizer["ProjectApprovedSuccess"];
            _statusMessageIntent = MessageIntent.Success;
            _project = await ProjectService.GetProjectAsync(ProjectId, _currentUserId);
            if (_project is not null && _project.Status == Core.Enums.ProjectStatus.Active)
            {
                _streak = await ProjectService.GetStreakAsync(ProjectId, _currentUserId);
            }
        });
    }

    private async Task HandleProposeChange()
    {
        await ExecuteAction(async () =>
        {
            _proposeError = null;
            var request = new ProposeChangeRequest { Type = _proposeType };

            if (_proposeType == Core.Enums.ChangeRequestType.EndDate)
                request.NewEndDate = _proposeEndDate;
            else if (_proposeType == Core.Enums.ChangeRequestType.Frequency)
                request.NewFrequency = _proposeFrequency;
            else if (_proposeType == Core.Enums.ChangeRequestType.Goals)
                request.Goals = _proposeGoals;

            var payloadJson = request.ToPayloadJson();
            await ProjectService.ProposeChangeAsync(ProjectId, _currentUserId, _proposeType, payloadJson);
            _statusMessage = Localizer["ChangeRequestCreatedSuccess"];
            _statusMessageIntent = MessageIntent.Success;
            _project = await ProjectService.GetProjectAsync(ProjectId, _currentUserId);
        }, ex => _proposeError = ex.Message);
    }

    private async Task HandleRespondToChangeRequest(Guid changeRequestId, bool approve)
    {
        var dialog = await DialogService.ShowConfirmationAsync(
            approve ? @Localizer["ConfirmApproveMessage"] : @Localizer["ConfirmRejectMessage"],
            primaryText: approve ? @Localizer["ApproveButton"] : @Localizer["RejectButton"],
            secondaryText: @Localizer["Cancel"],
            title: approve ? @Localizer["ConfirmApproveTitle"] : @Localizer["ConfirmRejectTitle"]);

        var result = await dialog.Result;
        if (result.Cancelled)
            return;

        await ExecuteAction(async () =>
        {
            await ProjectService.RespondToChangeRequestAsync(ProjectId, changeRequestId, _currentUserId, approve);
            _statusMessage = approve ? Localizer["ChangeRequestApprovedSuccess"] : Localizer["ChangeRequestRejectedSuccess"];
            _statusMessageIntent = MessageIntent.Success;
            _project = await ProjectService.GetProjectAsync(ProjectId, _currentUserId);
        });
    }

    private async Task ExecuteAction(Func<Task> action, Action<Exception>? onError = null)
    {
        _actionLoading = true;
        _statusMessage = null;

        try
        {
            await action();
        }
        catch (Exception ex)
        {
            _statusMessage = ex.Message;
            _statusMessageIntent = MessageIntent.Error;
            onError?.Invoke(ex);
        }
        finally
        {
            _actionLoading = false;
        }
    }

    private static string StatusColor(Core.Enums.ProjectStatus status) => status switch
    {
        Core.Enums.ProjectStatus.Pending => "var(--rm-accent)",
        Core.Enums.ProjectStatus.Active => "var(--rm-secondary)",
        Core.Enums.ProjectStatus.Finished => "#5B9279",
        Core.Enums.ProjectStatus.Cancelled => "var(--rm-primary)",
        _ => "var(--rm-text-muted)"
    };

    private static string CrBadgeClass(Core.Enums.ChangeRequestStatus status) => status switch
    {
        Core.Enums.ChangeRequestStatus.Approved => "approved",
        Core.Enums.ChangeRequestStatus.Rejected => "rejected",
        _ => "pending"
    };

    private string GetStatusText(Core.Enums.ProjectStatus status) => status switch
    {
        Core.Enums.ProjectStatus.Pending => Localizer["StatusPending"],
        Core.Enums.ProjectStatus.Active => Localizer["StatusActive"],
        Core.Enums.ProjectStatus.Finished => Localizer["StatusFinished"],
        Core.Enums.ProjectStatus.Cancelled => Localizer["StatusCancelled"],
        _ => status.ToString()
    };

    private string GetFrequencyText(Core.Enums.ProjectFrequency freq) => freq switch
    {
        Core.Enums.ProjectFrequency.Daily => Localizer["FrequencyDaily"],
        Core.Enums.ProjectFrequency.Weekly => Localizer["FrequencyWeekly"],
        Core.Enums.ProjectFrequency.Biweekly => Localizer["FrequencyBiweekly"],
        Core.Enums.ProjectFrequency.Monthly => Localizer["FrequencyMonthly"],
        _ => freq.ToString()
    };

    private string GetChangeRequestTypeText(Core.Enums.ChangeRequestType type) => type switch
    {
        Core.Enums.ChangeRequestType.EndDate => Localizer["ChangeTypeEndDate"],
        Core.Enums.ChangeRequestType.Frequency => Localizer["ChangeTypeFrequency"],
        Core.Enums.ChangeRequestType.Goals => Localizer["ChangeTypeGoals"],
        _ => type.ToString()
    };

    private string GetChangeRequestStatusText(Core.Enums.ChangeRequestStatus status) => status switch
    {
        Core.Enums.ChangeRequestStatus.Pending => Localizer["ChangeRequestStatusPending"],
        Core.Enums.ChangeRequestStatus.Approved => Localizer["ChangeRequestStatusApproved"],
        Core.Enums.ChangeRequestStatus.Rejected => Localizer["ChangeRequestStatusRejected"],
        _ => status.ToString()
    };
}
