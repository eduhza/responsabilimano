@inject IStringLocalizer<AppStrings> Localizer

<AuthorizeView>
    <Authorized>
        <nav class="nav">
            <NavLink href="/projects" Match="NavLinkMatch.All" class="nav__link">
                <RmIcon Name="folder" Size="1.125rem" />
                <span>@Localizer["NavProjects"]</span>
            </NavLink>

            <NavLink href="/projects/new" class="nav__link">
                <RmIcon Name="plus" Size="1.125rem" />
                <span>@Localizer["NavCreateProject"]</span>
            </NavLink>

            <NavLink href="/profile" class="nav__link">
                <RmIcon Name="user" Size="1.125rem" />
                <span>@Localizer["NavProfile"]</span>
            </NavLink>
        </nav>

        <RmButton Href="/projects/new" Block="true" Class="nav__cta">
            <RmIcon Name="plus" />
            @Localizer["NavCreateProject"]
        </RmButton>

        @* Pinned to the bottom: who you are signed in as, and the way out. *@
        <div class="nav__user">
            <RmAvatar Name="@context.User.Identity?.Name" Tone="neutral" />
            <div class="nav__user-text">
                <p class="nav__user-name">@context.User.Identity?.Name</p>
                <p class="nav__user-email">@context.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</p>
            </div>
        </div>

        <form method="post" action="api/auth/logout" class="nav__logout">
            <button type="submit" class="nav__link nav__link--button">
                <RmIcon Name="log-out" Size="1.125rem" />
                <span>@Localizer["LogoutButton"]</span>
            </button>
        </form>
    </Authorized>
    <NotAuthorized>
        <nav class="nav">
            <NavLink href="/login" class="nav__link">
                <RmIcon Name="arrow-right" Size="1.125rem" />
                <span>@Localizer["LoginButton"]</span>
            </NavLink>

            <NavLink href="/register" class="nav__link">
                <RmIcon Name="user" Size="1.125rem" />
                <span>@Localizer["RegisterButton"]</span>
            </NavLink>
        </nav>
    </NotAuthorized>
</AuthorizeView>
