@page "/projects/new"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IProjectService ProjectService
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> Localizer
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<CreateProject> Logger

<PageTitle>@Localizer["CreateProjectTitle"]</PageTitle>

<h3>@Localizer["CreateProjectTitle"]</h3>

@if (_success)
{
    <FluentMessageBar Intent="MessageIntent.Success" Title="@Localizer["CreateProjectSuccess"]" AllowDismiss="false" />

    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Class="mt-3">
        <FluentAnchor Href="@($"/projects/{_createdProjectId}/invite")" Appearance="Appearance.Accent">
            @Localizer["InvitePartnerButton"]
        </FluentAnchor>
        <FluentButton Appearance="Appearance.Neutral" OnClick="@(() => Navigation.NavigateTo("/"))">
            @Localizer["BackToHome"]
        </FluentButton>
    </FluentStack>
}
else
{
    <EditForm Model="_model" OnValidSubmit="HandleSubmit" FormName="createProjectForm">
        <DataAnnotationsValidator />
        <FluentValidationSummary />

        <FluentTextField Id="name"
                         Label="@Localizer["ProjectNameLabel"]"
                         Appearance="FluentInputAppearance.Outline"
                         @bind-Value="_model.Name"
                         Required
                         Style="width: 100%;" />
        <FluentValidationMessage For="@(() => _model.Name)" />

        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Style="margin-top: 1rem; flex-wrap: wrap;">
            <div>
                <FluentDatePicker Label="@Localizer["StartDateLabel"]"
                                  Value="_model.StartDate"
                                  ValueChanged="@(v => _model.StartDate = v ?? DateTime.Today)"
                                  Style="width: 100%;" />
                <FluentValidationMessage For="@(() => _model.StartDate)" />
            </div>
            <div>
                <FluentDatePicker Label="@Localizer["EndDateLabel"]"
                                  Value="_model.EndDate"
                                  ValueChanged="@(v => _model.EndDate = v ?? DateTime.Today)"
                                  Style="width: 100%;" />
                <FluentValidationMessage For="@(() => _model.EndDate)" />
            </div>
            <div style="min-width: 200px;">
                <FluentSelect TOption="string"
                              Id="frequency"
                              Label="@Localizer["FrequencyLabel"]"
                              Appearance="Appearance.Outline"
                              Value="_model.Frequency.ToString()"
                              ValueChanged="@(v => _model.Frequency = Enum.Parse<ProjectFrequency>(v ?? string.Empty))"
                              Style="width: 100%;">
                    <FluentOption Value="@ProjectFrequency.Daily.ToString()">@Localizer["FrequencyDaily"]</FluentOption>
                    <FluentOption Value="@ProjectFrequency.Weekly.ToString()">@Localizer["FrequencyWeekly"]</FluentOption>
                    <FluentOption Value="@ProjectFrequency.Biweekly.ToString()">@Localizer["FrequencyBiweekly"]</FluentOption>
                    <FluentOption Value="@ProjectFrequency.Monthly.ToString()">@Localizer["FrequencyMonthly"]</FluentOption>
                </FluentSelect>
                <FluentValidationMessage For="@(() => _model.Frequency)" />
            </div>
        </FluentStack>

        <h4 style="margin-top: 1.5rem;">@Localizer["GoalsSectionTitle"]</h4>

        @for (var i = 0; i < _model.Goals.Count; i++)
        {
            var index = i;
            <FluentCard Class="mb-3 goal-card">
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Style="justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                    <h5 style="margin: 0;">@Localizer["GoalLabel", index + 1]</h5>
                    @if (_model.Goals.Count > 1)
                    {
                        <FluentButton Type="ButtonType.Button"
                                      Appearance="Appearance.Outline"
                                      IconStart="@(new Icons.Regular.Size20.Delete())"
                                      IconColor="Color.Error"
                                      OnClick="@(() => RemoveGoal(index))">
                            @Localizer["RemoveGoalButton"]
                        </FluentButton>
                    }
                </FluentStack>

                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Style="flex-wrap: wrap;">
                    <div style="flex: 2; min-width: 200px;">
                        <FluentTextField Label="@Localizer["GoalFieldLabel"]"
                                         Appearance="FluentInputAppearance.Outline"
                                         @bind-Value="_model.Goals[index].Label"
                                         Style="width: 100%;" />
                    </div>
                    <div style="flex: 1; min-width: 150px;">
                        <FluentSelect TOption="string"
                                      Label="@Localizer["GoalDataTypeLabel"]"
                                      Appearance="Appearance.Outline"
                                      Value="_model.Goals[index].DataType.ToString()"
                                      ValueChanged="@(v => _model.Goals[index].DataType = Enum.Parse<GoalDataType>(v ?? string.Empty))"
                                      Style="width: 100%;">
                            <FluentOption Value="@GoalDataType.Decimal.ToString()">@Localizer["DataTypeDecimal"]</FluentOption>
                            <FluentOption Value="@GoalDataType.Integer.ToString()">@Localizer["DataTypeInteger"]</FluentOption>
                            <FluentOption Value="@GoalDataType.Percent.ToString()">@Localizer["DataTypePercent"]</FluentOption>
                        </FluentSelect>
                    </div>
                    <div style="flex: 1; min-width: 100px;">
                        <FluentTextField Label="@Localizer["GoalUnitLabel"]"
                                         Appearance="FluentInputAppearance.Outline"
                                         @bind-Value="_model.Goals[index].Unit"
                                         Style="width: 100%;" />
                    </div>
                </FluentStack>

                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Style="flex-wrap: wrap; margin-top: 0.75rem;">
                    <div style="flex: 1; min-width: 120px;">
                        <FluentNumberField TValue="decimal?"
                                           Label="@Localizer["GoalMinValueLabel"]"
                                           Appearance="FluentInputAppearance.Outline"
                                           HideStep="true"
                                           @bind-Value="_model.Goals[index].MinValue"
                                           Style="width: 100%;" />
                    </div>
                    <div style="flex: 1; min-width: 120px;">
                        <FluentNumberField TValue="decimal?"
                                           Label="@Localizer["GoalMaxValueLabel"]"
                                           Appearance="FluentInputAppearance.Outline"
                                           HideStep="true"
                                           @bind-Value="_model.Goals[index].MaxValue"
                                           Style="width: 100%;" />
                    </div>
                    <div style="flex: 1; min-width: 120px;">
                        <FluentNumberField TValue="decimal?"
                                           Label="@Localizer["GoalTargetValueLabel"]"
                                           Appearance="FluentInputAppearance.Outline"
                                           HideStep="true"
                                           @bind-Value="_model.Goals[index].TargetValue"
                                           Style="width: 100%;" />
                    </div>
                </FluentStack>
            </FluentCard>
        }

        <FluentButton Type="ButtonType.Button"
                      Appearance="Appearance.Outline"
                      IconStart="@(new Icons.Regular.Size20.Add())"
                      OnClick="AddGoal"
                      Class="mb-3">
            @Localizer["AddGoalButton"]
        </FluentButton>

        @if (!string.IsNullOrEmpty(_error))
        {
            <FluentMessageBar Intent="MessageIntent.Error" Title="@_error" AllowDismiss="false" />
        }

        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12">
            <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Disabled="@_isLoading" Loading="@_isLoading">
                @(_isLoading ? Localizer["Creating"] : Localizer["CreateProjectButton"])
            </FluentButton>
            <FluentAnchor Href="/" Appearance="Appearance.Neutral">
                @Localizer["Cancel"]
            </FluentAnchor>
        </FluentStack>
    </EditForm>
}

@code {
    private CreateProjectRequest _model = new();
    private string? _error;
    private bool _isLoading;
    private bool _success;
    private Guid _createdProjectId;

    protected override void OnInitialized()
    {
        if (_model.Goals.Count == 0)
        {
            _model.Goals.Add(new GoalFieldRequest());
        }
    }

    private void AddGoal()
    {
        _model.Goals.Add(new GoalFieldRequest());
    }

    private void RemoveGoal(int index)
    {
        if (_model.Goals.Count > 1)
        {
            _model.Goals.RemoveAt(index);
        }
    }

    private async Task HandleSubmit()
    {
        _isLoading = true;
        _error = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userIdStr = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            if (userIdStr is null || !Guid.TryParse(userIdStr, out var userId))
            {
                _error = Localizer["CreateProjectError"];
                return;
            }

            var goals = _model.Goals.Select(g => new GoalFieldInput(
                g.Label, g.DataType, g.Unit, g.MinValue, g.MaxValue, g.TargetValue));

            var project = await ProjectService.CreateProjectAsync(
                userId, _model.Name, _model.StartDate, _model.EndDate,
                _model.Frequency, goals);

            _createdProjectId = project.Id;
            _success = true;
        }
        catch (ArgumentException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to create project");
            _error = Localizer["CreateProjectError"];
        }
        finally
        {
            _isLoading = false;
        }
    }
}
