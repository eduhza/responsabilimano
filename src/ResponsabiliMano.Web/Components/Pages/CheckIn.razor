@page "/projects/{ProjectId:guid}/checkin"
@rendermode InteractiveServer
@attribute [Authorize]
@inject ICheckInService CheckInService
@inject IFeatureManager FeatureManager
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> Localizer
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<CheckIn> Logger
@using Microsoft.FeatureManagement
@using ResponsabiliMano.Core.Entities

<PageTitle>@Localizer["CheckInTitle"]</PageTitle>

@if (_loading)
{
    <div class="skeleton" style="width: 50%; height: 2rem; margin-bottom: 1.5rem;"></div>
    <div class="skeleton" style="width: 100%; height: 4rem; margin-bottom: 1.5rem;"></div>
    <div class="skeleton" style="width: 100%; height: 6rem;"></div>
}
else if (!_available || _project is null)
{
    <FluentMessageBar Intent="MessageIntent.Error" Title="@Localizer["ProjectNotFound"]" AllowDismiss="false" />
    <FluentButton Appearance="Appearance.Neutral" OnClick="@(() => Navigation.NavigateTo("/"))" Class="mt-3">
        @Localizer["BackToHome"]
    </FluentButton>
}
else if (_success || _alreadySubmitted)
{
    <h3>@Localizer["CheckInTitle"]</h3>
    <FluentMessageBar Intent="MessageIntent.Success" Title="@(_success ? Localizer["CheckInSuccess"] : Localizer["CheckInAlreadyDone"])" AllowDismiss="false" />
    <FluentAnchor Href="@($"/projects/{ProjectId}")" Appearance="Appearance.Neutral" Class="mt-3">
        @Localizer["BackToProject"]
    </FluentAnchor>
}
else
{
    <h3>@Localizer["CheckInTitle"]</h3>
    <p class="text-muted">@_project.Name — @Localizer["CheckInPeriodLabel", _period]</p>

    <h4>@Localizer["CheckInMetricsTitle"]</h4>
    @foreach (var entry in _metrics)
    {
        <div class="mb-3" style="max-width: 400px;">
            <FluentNumberField TValue="decimal?"
                               Label="@entry.Goal.Label"
                               Appearance="FluentInputAppearance.Outline"
                               HideStep="true"
                               Min="@entry.Goal.MinValue?.ToString()"
                               Max="@entry.Goal.MaxValue?.ToString()"
                               @bind-Value="entry.Value"
                               Style="width: 100%;" />
            <span class="text-muted" style="font-size: 0.85rem;">
                @entry.Goal.Unit
                @if (entry.Goal.MinValue is not null || entry.Goal.MaxValue is not null)
                {
                    <span> — @entry.Goal.MinValue … @entry.Goal.MaxValue</span>
                }
            </span>
        </div>
    }

    <h4>@Localizer["CheckInFeelingTitle"]</h4>
    <div class="feeling-selector" role="radiogroup" aria-label="@Localizer["CheckInFeelingTitle"]">
        @foreach (var feeling in Feelings)
        {
            var current = feeling;
            <button type="button"
                    class="feeling-button @(_feeling == current ? "selected" : string.Empty)"
                    aria-pressed="@(_feeling == current)"
                    title="@FeelingText(current)"
                    @onclick="() => _feeling = current">
                <FeelingFace Feeling="current" Size="48" />
                <span class="feeling-label">@FeelingText(current)</span>
            </button>
        }
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <FluentMessageBar Intent="MessageIntent.Error" Title="@_error" AllowDismiss="false" Class="mb-3" />
    }

    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12">
        <FluentButton Type="ButtonType.Button" Appearance="Appearance.Accent" Disabled="@_submitting" Loading="@_submitting" OnClick="HandleSubmit">
            @(_submitting ? Localizer["Processing"] : Localizer["CheckInSubmitButton"])
        </FluentButton>
        <FluentAnchor Href="@($"/projects/{ProjectId}")" Appearance="Appearance.Neutral">
            @Localizer["Cancel"]
        </FluentAnchor>
    </FluentStack>
}

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    private static readonly Feeling[] Feelings =
        [Feeling.VerySad, Feeling.Sad, Feeling.Neutral, Feeling.Happy, Feeling.VeryHappy];

    private Project? _project;
    private int _period;
    private bool _available = true;
    private bool _loading = true;
    private bool _alreadySubmitted;
    private bool _submitting;
    private bool _success;
    private string? _error;
    private Feeling _feeling = Feeling.Neutral;
    private readonly List<MetricEntry> _metrics = new();
    private Guid _currentUserId;

    protected override async Task OnInitializedAsync()
    {
        if (!await FeatureManager.IsEnabledAsync(FeatureFlags.CheckIns))
        {
            _available = false;
            _loading = false;
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdStr = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userIdStr is null || !Guid.TryParse(userIdStr, out _currentUserId))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            var form = await CheckInService.GetCheckInFormAsync(ProjectId, _currentUserId);
            if (form is null || form.PeriodNumber < 1)
            {
                _available = false;
                return;
            }

            _project = form.Project;
            _period = form.PeriodNumber;
            _alreadySubmitted = form.AlreadySubmitted;
            _metrics.AddRange(form.Project.Goals.Select(g => new MetricEntry(g)));
        }
        catch (UnauthorizedAccessException)
        {
            _available = false;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandleSubmit()
    {
        _submitting = true;
        _error = null;

        try
        {
            if (_metrics.Any(m => m.Value is null))
            {
                _error = Localizer["CheckInMissingValues"];
                return;
            }

            var metrics = _metrics
                .Select(m => new CheckInMetricInput(m.Goal.Id, m.Value!.Value))
                .ToList();

            await CheckInService.SubmitCheckInAsync(ProjectId, _currentUserId, _feeling, metrics);
            _success = true;
        }
        catch (ArgumentException ex)
        {
            _error = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to submit check-in for project {ProjectId}", ProjectId);
            _error = Localizer["CheckInError"];
        }
        finally
        {
            _submitting = false;
        }
    }

    private string FeelingText(Feeling feeling) => feeling switch
    {
        Feeling.VerySad => Localizer["FeelingVerySad"],
        Feeling.Sad => Localizer["FeelingSad"],
        Feeling.Neutral => Localizer["FeelingNeutral"],
        Feeling.Happy => Localizer["FeelingHappy"],
        Feeling.VeryHappy => Localizer["FeelingVeryHappy"],
        _ => feeling.ToString()
    };

    private sealed class MetricEntry
    {
        public MetricEntry(GoalField goal) => Goal = goal;
        public GoalField Goal { get; }
        public decimal? Value { get; set; }
    }
}
