@page "/projects/{ProjectId:guid}/invite"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IProjectService ProjectService
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> Localizer
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<InvitePartner> Logger

<PageTitle>@Localizer["InvitePartnerTitle"]</PageTitle>

<div class="invite">
    @if (_success)
    {
        <RmEmptyState Icon="mail" Title="@Localizer["InvitePartnerSuccess"].Value">
            <RmButton Href="@($"/projects/{ProjectId}")" Variant="outline">@Localizer["BackToProject"]</RmButton>
        </RmEmptyState>
    }
    else
    {
        <a href="@($"/projects/{ProjectId}")" class="rm-back-link">
            <RmIcon Name="arrow-left" Size="0.875rem" />
            @Localizer["BackToProject"]
        </a>

        <h1 class="invite__title">@Localizer["InvitePartnerTitle"]</h1>
        <p class="invite__subtitle">@Localizer["InvitePartnerSubtitle"]</p>

        <EditForm Model="_model" OnValidSubmit="HandleSubmit" FormName="invitePartnerForm" class="invite__form">
            <DataAnnotationsValidator />

            <RmField Label="@Localizer["PartnerEmailLabel"]" For="partnerEmail">
                <InputText id="partnerEmail" type="email" class="rm-input" @bind-Value="_model.PartnerEmail"
                           placeholder="@PartnerEmailPlaceholder" />
                <ValidationMessage For="@(() => _model.PartnerEmail)" />
            </RmField>

            @if (!string.IsNullOrEmpty(_error))
            {
                <RmAlert Tone="danger">@_error</RmAlert>
            }

            <div class="invite__actions">
                <RmButton Href="@($"/projects/{ProjectId}")" Variant="outline">@Localizer["Cancel"]</RmButton>
                <button type="submit" class="rm-btn rm-btn--primary" disabled="@_isLoading">
                    @(_isLoading ? Localizer["Sending"] : Localizer["InvitePartnerButton"])
                </button>
            </div>
        </EditForm>
    }
</div>

@code {
    // Literal in C# rather than the markup: Razor reads a bare @ in an attribute
    // value as the start of an expression.
    private const string PartnerEmailPlaceholder = "parceiro@email.com";

    [Parameter]
    public Guid ProjectId { get; set; }

    private InvitePartnerRequest _model = new();
    private string? _error;
    private bool _isLoading;
    private bool _success;

    private async Task HandleSubmit()
    {
        _isLoading = true;
        _error = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userIdStr = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            if (userIdStr is null || !Guid.TryParse(userIdStr, out var userId))
            {
                _error = Localizer["InvitePartnerError"];
                return;
            }

            var baseUrl = Navigation.BaseUri.TrimEnd('/');

            await ProjectService.InvitePartnerAsync(ProjectId, userId, _model.PartnerEmail, baseUrl);

            _success = true;
        }
        catch (UnauthorizedAccessException)
        {
            _error = Localizer["InvitePartnerUnauthorized"];
        }
        catch (ArgumentException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to invite partner to project {ProjectId}", ProjectId);
            _error = Localizer["InvitePartnerError"];
        }
        finally
        {
            _isLoading = false;
        }
    }
}
