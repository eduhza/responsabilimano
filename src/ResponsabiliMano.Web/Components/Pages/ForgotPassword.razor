@page "/forgot-password"
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@inject IPasswordResetService ResetService
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> Localizer
@inject ILogger<ForgotPassword> Logger

<PageTitle>@Localizer["ForgotPasswordTitle"]</PageTitle>

<div class="rm-auth">
    <div class="rm-auth-brand">
        <div class="rm-auth-wordmark">Responsabili<span class="accent">Mano</span></div>
        <div class="rm-auth-tagline">@Localizer["AuthTagline"]</div>
    </div>

    <div class="rm-auth-card">
        <h3>@Localizer["ForgotPasswordTitle"]</h3>

        @if (_submitted)
        {
            <div class="alert-success" role="alert">@Localizer["ForgotPasswordSent"]</div>
        }
        else
        {
            <EditForm Model="_model" OnValidSubmit="HandleSubmit" FormName="forgotPasswordForm">
                <DataAnnotationsValidator />

                <div class="rm-field">
                    <label for="email" class="rm-label">@Localizer["EmailLabel"]</label>
                    <InputText id="email" type="email" class="rm-input" @bind-Value="_model.Email" />
                    <ValidationMessage For="@(() => _model.Email)" />
                </div>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert-danger" role="alert">@_error</div>
                }

                <button type="submit" class="rm-btn" disabled="@_isLoading">
                    @(_isLoading ? Localizer["Sending"] : Localizer["SendResetLinkButton"])
                </button>
            </EditForm>
        }
    </div>

    <div class="rm-auth-links">
        <p><a href="/login">@Localizer["BackToLogin"]</a></p>
    </div>
</div>

@code {
    private ForgotPasswordRequest _model = new();
    private string? _error;
    private bool _isLoading;
    private bool _submitted;

    private async Task HandleSubmit()
    {
        _isLoading = true;
        _error = null;

        try
        {
            await ResetService.RequestResetAsync(_model.Email, Navigation.BaseUri);
            _submitted = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to request password reset");
            _error = Localizer["ForgotPasswordError"];
        }
        finally
        {
            _isLoading = false;
        }
    }
}
