@page "/reset-password"
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@inject IPasswordResetService ResetService
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> Localizer
@inject ILogger<ResetPassword> Logger

<PageTitle>@Localizer["ResetPasswordTitle"]</PageTitle>

<div class="rm-auth">
    <div class="rm-auth-brand">
        <div class="rm-auth-wordmark">Responsabili<span class="accent">Mano</span></div>
        <div class="rm-auth-tagline">@Localizer["AuthTagline"]</div>
    </div>

    <div class="rm-auth-card">
        <h3>@Localizer["ResetPasswordTitle"]</h3>

        @if (_success)
        {
            <div class="alert-success" role="alert">@Localizer["ResetPasswordSuccess"]</div>
        }
        else
        {
            <EditForm Model="_model" OnValidSubmit="HandleSubmit" FormName="resetPasswordForm">
                <DataAnnotationsValidator />

                <div class="rm-field">
                    <label for="password" class="rm-label">@Localizer["NewPasswordLabel"]</label>
                    <InputText id="password" type="password" class="rm-input" @bind-Value="_model.Password" />
                    <ValidationMessage For="@(() => _model.Password)" />
                </div>

                <div class="rm-field">
                    <label for="confirmPassword" class="rm-label">@Localizer["ConfirmPasswordLabel"]</label>
                    <InputText id="confirmPassword" type="password" class="rm-input" @bind-Value="_model.ConfirmPassword" />
                    <ValidationMessage For="@(() => _model.ConfirmPassword)" />
                </div>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert-danger" role="alert">@_error</div>
                }

                <button type="submit" class="rm-btn" disabled="@_isLoading">
                    @(_isLoading ? Localizer["Resetting"] : Localizer["ResetPasswordButton"])
                </button>
            </EditForm>
        }
    </div>

    <div class="rm-auth-links">
        <p><a href="/login">@Localizer["BackToLogin"]</a></p>
    </div>
</div>

@code {
    private ResetPasswordRequest _model = new();
    private string? _error;
    private bool _isLoading;
    private bool _success;

    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(Token))
        {
            _model.Token = Token;
        }
    }

    private async Task HandleSubmit()
    {
        _isLoading = true;
        _error = null;

        try
        {
            var result = await ResetService.ResetPasswordAsync(_model.Token, _model.Password);
            if (result)
            {
                _success = true;
            }
            else
            {
                _error = Localizer["ResetPasswordInvalidToken"];
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to reset password");
            _error = Localizer["ResetPasswordError"];
        }
        finally
        {
            _isLoading = false;
        }
    }
}
