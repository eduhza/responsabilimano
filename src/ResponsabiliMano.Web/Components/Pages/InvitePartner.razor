@page "/projects/{ProjectId:guid}/invite"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IProjectService ProjectService
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> Localizer
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<InvitePartner> Logger

<PageTitle>@Localizer["InvitePartnerTitle"]</PageTitle>

<h3>@Localizer["InvitePartnerTitle"]</h3>

@if (_success)
{
    <FluentMessageBar Intent="MessageIntent.Success" Title="@Localizer["InvitePartnerSuccess"]" AllowDismiss="false" />
    <FluentButton Appearance="Appearance.Neutral" OnClick="@(() => Navigation.NavigateTo("/"))" Class="mt-3">
        @Localizer["BackToHome"]
    </FluentButton>
}
else
{
    <EditForm Model="_model" OnValidSubmit="HandleSubmit" FormName="invitePartnerForm">
        <DataAnnotationsValidator />
        <FluentValidationSummary />

        <FluentTextField Id="partnerEmail"
                         Label="@Localizer["PartnerEmailLabel"]"
                         Appearance="FluentInputAppearance.Outline"
                         TextFieldType="TextFieldType.Email"
                         @bind-Value="_model.PartnerEmail"
                         Required
                         Style="width: 100%; max-width: 400px;" />
        <FluentValidationMessage For="@(() => _model.PartnerEmail)" />

        @if (!string.IsNullOrEmpty(_error))
        {
            <FluentMessageBar Intent="MessageIntent.Error" Title="@_error" AllowDismiss="false" Class="mt-3" />
        }

        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Class="mt-3">
            <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Disabled="@_isLoading" Loading="@_isLoading">
                @(_isLoading ? Localizer["Sending"] : Localizer["InvitePartnerButton"])
            </FluentButton>
            <FluentAnchor Href="/" Appearance="Appearance.Neutral">
                @Localizer["Cancel"]
            </FluentAnchor>
        </FluentStack>
    </EditForm>
}

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    private InvitePartnerRequest _model = new();
    private string? _error;
    private bool _isLoading;
    private bool _success;

    private async Task HandleSubmit()
    {
        _isLoading = true;
        _error = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userIdStr = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            if (userIdStr is null || !Guid.TryParse(userIdStr, out var userId))
            {
                _error = Localizer["InvitePartnerError"];
                return;
            }

            var baseUrl = Navigation.BaseUri.TrimEnd('/');

            await ProjectService.InvitePartnerAsync(ProjectId, userId, _model.PartnerEmail, baseUrl);

            _success = true;
        }
        catch (UnauthorizedAccessException)
        {
            _error = Localizer["InvitePartnerUnauthorized"];
        }
        catch (ArgumentException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to invite partner to project {ProjectId}", ProjectId);
            _error = Localizer["InvitePartnerError"];
        }
        finally
        {
            _isLoading = false;
        }
    }
}
