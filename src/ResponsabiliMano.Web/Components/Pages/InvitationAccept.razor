@page "/invitations/{Token}"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IProjectService ProjectService
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> Localizer
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<InvitationAccept> Logger

<PageTitle>@Localizer["InvitationTitle"]</PageTitle>

@if (_loading)
{
    <div class="skeleton accept__skeleton accept__skeleton--head"></div>
    <div class="skeleton accept__skeleton accept__skeleton--body"></div>
}
else if (_error is not null)
{
    <RmAlert Tone="danger">@_error</RmAlert>
    <RmButton Href="/projects" Variant="outline" Class="mt-3">@Localizer["BackToHome"]</RmButton>
}
else if (_project is not null)
{
    <div class="accept">
        @if (_accepted)
        {
            <RmAlert Tone="success">@Localizer["InvitationAccepted"]</RmAlert>
        }
        else
        {
            <RmSectionHeader Title="@Localizer["InvitationTitle"].Value"
                             Description="@Localizer["InvitationPreviewText"].Value" />
        }

        <RmCard Class="accept__hero">
            <div class="accept__identity">
                <span class="rm-icon-tile rm-icon-tile--lg rm-icon-tile--accent accept__emoji">@(_project.Icon ?? "🎯")</span>
                <div>
                    <RmBadge Tone="@StatusTone(_project.Status)" Dot="true">@GetStatusText(_project.Status)</RmBadge>
                    <h1 class="accept__title">@_project.Name</h1>
                    <div class="accept__meta">
                        <span>
                            <RmIcon Name="calendar" Size="0.875rem" />
                            @_project.StartDate.ToString("dd MMM yyyy") — @_project.EndDate.ToString("dd MMM yyyy")
                        </span>
                        <span>
                            <RmIcon Name="repeat" Size="0.875rem" />
                            @GetFrequencyText(_project.Frequency)
                        </span>
                    </div>
                </div>
            </div>
        </RmCard>

        <h2 class="accept__section">@Localizer["GoalsSectionTitle"]</h2>
        <div class="accept__goals">
            @foreach (var goal in _project.Goals)
            {
                <RmCard Flat="true">
                    <p class="accept__goal-label">@goal.Label</p>
                    <p class="accept__goal-target rm-display rm-tabular">
                        @(goal.TargetValue?.ToString("0.##") ?? "—")<span class="accept__goal-unit">@goal.Unit</span>
                    </p>
                </RmCard>
            }
        </div>

        @if (!string.IsNullOrEmpty(_statusMessage))
        {
            <RmAlert Tone="@_statusTone" Class="mt-3">@_statusMessage</RmAlert>
        }

        @if (!_accepted)
        {
            <RmButton Disabled="_actionLoading" @onclick="HandleAcceptInvitation" Class="mt-3">
                <RmIcon Name="handshake" />
                @(_actionLoading ? Localizer["Processing"] : Localizer["AcceptInvitationButton"])
            </RmButton>
        }
        else if (_project.Status == Core.Enums.ProjectStatus.Pending)
        {
            <RmCard Class="accept__approve">
                <div>
                    <h2 class="accept__approve-title">@Localizer["ApproveProjectTitle"]</h2>
                    <p class="accept__approve-text">@Localizer["ApproveProjectDescription"]</p>
                </div>
                <div class="accept__approve-actions">
                    <RmButton Href="@($"/projects/{_project.Id}")" Variant="outline">@Localizer["ProposeChangeButton"]</RmButton>
                    <RmButton Disabled="_actionLoading" @onclick="HandleApproveProject">@Localizer["ApproveButton"]</RmButton>
                </div>
            </RmCard>
        }
        else
        {
            <RmButton Href="@($"/projects/{_project.Id}")" Variant="outline" Class="mt-3">
                @Localizer["ViewProjectDetails"]
            </RmButton>
        }

        <RmConfirmDialog @ref="_confirmDialog"
                         Title="@Localizer["ConfirmApproveTitle"]"
                         Message="@Localizer["ConfirmApproveMessage"]"
                         ConfirmText="@Localizer["ApproveButton"]"
                         CancelText="@Localizer["Cancel"]" />
    </div>
}

@code {
    [Parameter]
    public string Token { get; set; } = string.Empty;

    private Core.Entities.Project? _project;
    private Guid _currentUserId;
    private bool _loading = true;
    private bool _accepted;
    private bool _actionLoading;
    private string? _error;
    private string? _statusMessage;
    private string _statusTone = "info";

    private RmConfirmDialog? _confirmDialog;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdStr = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (userIdStr is null || !Guid.TryParse(userIdStr, out _currentUserId))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            _project = await TryPreviewProject();

            if (_project is null)
            {
                _error = Localizer["InvitationInvalidOrExpired"];
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load invitation preview");
            _error = Localizer["InvitationError"];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task<Core.Entities.Project?> TryPreviewProject()
    {
        try
        {
            return await ProjectService.GetInvitationProjectAsync(Token);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load invitation preview");
            return null;
        }
    }

    private async Task HandleAcceptInvitation()
    {
        _actionLoading = true;
        _error = null;

        try
        {
            var result = await ProjectService.AcceptInvitationAsync(Token, _currentUserId);
            if (result is null)
            {
                _error = Localizer["InvitationInvalidOrExpired"];
            }
            else
            {
                _project = result;
                _accepted = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to accept invitation for user {UserId}", _currentUserId);
            _error = Localizer["InvitationError"];
        }
        finally
        {
            _actionLoading = false;
        }
    }

    private async Task HandleApproveProject()
    {
        if (_confirmDialog is null || !await _confirmDialog.ShowAsync())
            return;

        _actionLoading = true;
        _statusMessage = null;

        try
        {
            if (_project is null) return;
            await ProjectService.ApproveProjectAsync(_project.Id, _currentUserId);
            _project = await ProjectService.GetProjectAsync(_project.Id, _currentUserId);
            _statusMessage = Localizer["ProjectApprovedSuccess"];
            _statusTone = "success";
        }
        catch (Exception ex)
        {
            _statusMessage = ex.Message;
            _statusTone = "danger";
        }
        finally
        {
            _actionLoading = false;
        }
    }

    private static string StatusTone(Core.Enums.ProjectStatus status) => status switch
    {
        Core.Enums.ProjectStatus.Active => "primary",
        Core.Enums.ProjectStatus.Pending => "partner",
        Core.Enums.ProjectStatus.Cancelled => "destructive",
        _ => "muted"
    };

    private string GetStatusText(Core.Enums.ProjectStatus status) => status switch
    {
        Core.Enums.ProjectStatus.Pending => Localizer["StatusPending"],
        Core.Enums.ProjectStatus.Active => Localizer["StatusActive"],
        Core.Enums.ProjectStatus.Finished => Localizer["StatusFinished"],
        Core.Enums.ProjectStatus.Cancelled => Localizer["StatusCancelled"],
        _ => status.ToString()
    };

    private string GetFrequencyText(Core.Enums.ProjectFrequency freq) => freq switch
    {
        Core.Enums.ProjectFrequency.Daily => Localizer["FrequencyDaily"],
        Core.Enums.ProjectFrequency.Weekly => Localizer["FrequencyWeekly"],
        Core.Enums.ProjectFrequency.Biweekly => Localizer["FrequencyBiweekly"],
        Core.Enums.ProjectFrequency.Monthly => Localizer["FrequencyMonthly"],
        _ => freq.ToString()
    };
}
