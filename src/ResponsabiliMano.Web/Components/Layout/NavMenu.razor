@inject IStringLocalizer<AppStrings> Localizer
@inject IFeatureManager FeatureManager
@using Microsoft.FeatureManagement

<AuthorizeView>
    <Authorized>
        <nav class="nav">
            @* Painel is the account-wide panel (spec S6.1), so it is a real
               destination whenever the Dashboard flag is on. Check-in is now a
               global page under its own flag, so it becomes a real link too. *@
            @if (_dashboardEnabled)
            {
                <NavLink href="/dashboard" class="nav__link">
                    <RmIcon Name="layout-dashboard" Size="1.125rem" />
                    <span>@Localizer["NavDashboard"]</span>
                </NavLink>
            }
            else
            {
                <span class="nav__link nav__link--disabled" aria-disabled="true">
                    <RmIcon Name="layout-dashboard" Size="1.125rem" />
                    <span>@Localizer["NavDashboard"]</span>
                </span>
            }

            <NavLink href="/projects" Match="NavLinkMatch.All" class="nav__link">
                <RmIcon Name="folder" Size="1.125rem" />
                <span>@Localizer["NavProjects"]</span>
            </NavLink>

            @if (_checkInsEnabled)
            {
                <NavLink href="/checkin" class="nav__link">
                    <RmIcon Name="check-circle" Size="1.125rem" />
                    <span>@Localizer["NavCheckIn"]</span>
                </NavLink>
            }
            else
            {
                <span class="nav__link nav__link--disabled" aria-disabled="true">
                    <RmIcon Name="check-circle" Size="1.125rem" />
                    <span>@Localizer["NavCheckIn"]</span>
                </span>
            }

            <NavLink href="/profile" class="nav__link">
                <RmIcon Name="user" Size="1.125rem" />
                <span>@Localizer["NavProfile"]</span>
            </NavLink>
        </nav>

        <div class="nav__cta">
            <RmButton Href="/projects/new" Block="true">
                <RmIcon Name="plus" />
                @Localizer["NavCreateProject"]
            </RmButton>
        </div>

        @* Pinned to the bottom: who you are signed in as, and the way out. *@
        <div class="nav__user">
            <RmAvatar Name="@context.User.Identity?.Name" Tone="neutral" />
            <div class="nav__user-text">
                <p class="nav__user-name">@context.User.Identity?.Name</p>
                <p class="nav__user-email">@context.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</p>
            </div>
        </div>

        <form method="post" action="api/auth/logout" class="nav__logout">
            <button type="submit" class="nav__link nav__link--button">
                <RmIcon Name="log-out" Size="1.125rem" />
                <span>@Localizer["LogoutButton"]</span>
            </button>
        </form>
    </Authorized>
    <NotAuthorized>
        <nav class="nav">
            <NavLink href="/login" class="nav__link">
                <RmIcon Name="arrow-right" Size="1.125rem" />
                <span>@Localizer["LoginButton"]</span>
            </NavLink>

            <NavLink href="/register" class="nav__link">
                <RmIcon Name="user" Size="1.125rem" />
                <span>@Localizer["RegisterButton"]</span>
            </NavLink>
        </nav>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _dashboardEnabled;
    private bool _checkInsEnabled;

    protected override async Task OnInitializedAsync()
    {
        _dashboardEnabled = await FeatureManager.IsEnabledAsync(FeatureFlags.Dashboard);
        _checkInsEnabled = await FeatureManager.IsEnabledAsync(FeatureFlags.CheckIns);
    }
}
