@page "/projects/new"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IProjectService ProjectService
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> Localizer
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<CreateProject> Logger

@* Three visual steps over a single EditForm — the wizard is presentation only, so
   validation and submission stay one atomic operation. *@

<PageTitle>@Localizer["CreateProjectTitle"]</PageTitle>

<div class="create">
    @if (_success)
    {
        <RmAlert Tone="success">@Localizer["CreateProjectSuccess"]</RmAlert>

        <div class="create__actions mt-3">
            <RmButton Href="@($"/projects/{_createdProjectId}/invite")">@Localizer["InvitePartnerButton"]</RmButton>
            <RmButton Href="/projects" Variant="outline">@Localizer["BackToHome"]</RmButton>
        </div>
    }
    else
    {
        <a href="/projects" class="rm-back-link">
            <RmIcon Name="arrow-left" Size="0.875rem" />
            @Localizer["MyProjectsTitle"]
        </a>

        <h1 class="create__title">@Localizer["CreateProjectTitle"]</h1>
        <p class="create__subtitle">@Localizer["CreateProjectSubtitle"]</p>

        <ol class="stepper">
            @foreach (var step in Steps)
            {
                <li class="stepper__item">
                    <span class="stepper__chip @(step.Index <= _step ? "is-active" : null)">
                        <RmIcon Name="@step.Icon" Size="0.875rem" />
                        <span class="stepper__label">@step.Label</span>
                    </span>
                    @if (step.Index < Steps.Length - 1)
                    {
                        <span class="stepper__line"></span>
                    }
                </li>
            }
        </ol>

        <EditForm Model="_model" OnValidSubmit="HandleSubmit" FormName="createProjectForm" class="create__form">
            <DataAnnotationsValidator />

            @* Every step stays mounted so bound values survive navigation; only the
               active one is displayed. *@
            <div class="create__step" hidden="@(_step != 0)">
                <RmField Label="@Localizer["ProjectNameLabel"]" For="name">
                    <InputText id="name" class="rm-input" @bind-Value="_model.Name"
                               placeholder="@Localizer["ProjectNamePlaceholder"]" />
                    <ValidationMessage For="@(() => _model.Name)" />
                </RmField>

                <RmField Label="@Localizer["ProjectIconLabel"]">
                    <div class="icon-picker">
                        @foreach (var icon in IconChoices)
                        {
                            <button type="button"
                                    class="icon-picker__option @(_model.Icon == icon ? "is-selected" : null)"
                                    aria-pressed="@(_model.Icon == icon)"
                                    @onclick="() => _model.Icon = icon">
                                @icon
                            </button>
                        }
                    </div>
                </RmField>

                <div class="create__grid">
                    <RmField Label="@Localizer["StartDateLabel"]" For="startDate">
                        <InputDate id="startDate" class="rm-input" @bind-Value="_model.StartDate" />
                        <ValidationMessage For="@(() => _model.StartDate)" />
                    </RmField>

                    <RmField Label="@Localizer["EndDateLabel"]" For="endDate">
                        <InputDate id="endDate" class="rm-input" @bind-Value="_model.EndDate" />
                        <ValidationMessage For="@(() => _model.EndDate)" />
                    </RmField>
                </div>

                <RmField Label="@Localizer["FrequencyLabel"]" For="frequency">
                    <InputSelect id="frequency" class="rm-select" @bind-Value="_model.Frequency">
                        <option value="@ProjectFrequency.Daily">@Localizer["FrequencyDaily"]</option>
                        <option value="@ProjectFrequency.Weekly">@Localizer["FrequencyWeekly"]</option>
                        <option value="@ProjectFrequency.Biweekly">@Localizer["FrequencyBiweekly"]</option>
                        <option value="@ProjectFrequency.Monthly">@Localizer["FrequencyMonthly"]</option>
                    </InputSelect>
                </RmField>
            </div>

            <div class="create__step" hidden="@(_step != 1)">
                @for (var i = 0; i < _model.Goals.Count; i++)
                {
                    var index = i;
                    <RmCard Class="goal">
                        <div class="goal__head">
                            <h2 class="goal__title">@Localizer["GoalLabel", index + 1]</h2>
                            @if (_model.Goals.Count > 1)
                            {
                                <RmButton Variant="ghost" Size="sm" @onclick="() => RemoveGoal(index)">
                                    <RmIcon Name="x" />
                                    @Localizer["RemoveGoalButton"]
                                </RmButton>
                            }
                        </div>

                        <div class="goal__grid">
                            <RmField Label="@Localizer["GoalFieldLabel"]" Class="goal__span-2">
                                <InputText class="rm-input" @bind-Value="_model.Goals[index].Goal.Label" />
                            </RmField>

                            <RmField Label="@Localizer["GoalDataTypeLabel"]">
                                <select class="rm-select"
                                        value="@_model.Goals[index].Goal.DataType"
                                        @onchange="e => OnDataTypeChanged(index, e)">
                                    <option value="@GoalDataType.Decimal">@Localizer["DataTypeDecimal"]</option>
                                    <option value="@GoalDataType.Integer">@Localizer["DataTypeInteger"]</option>
                                    <option value="@GoalDataType.Percent">@Localizer["DataTypePercent"]</option>
                                    <option value="@GoalDataType.Boolean">@Localizer["DataTypeBoolean"]</option>
                                    <option value="@GoalDataType.Scale">@Localizer["DataTypeScale"]</option>
                                </select>
                                @if (_model.Goals[index].Goal.DataType == GoalDataType.Boolean)
                                {
                                    <span class="rm-field__hint">@Localizer["DataTypeBooleanHelp"]</span>
                                }
                                else if (_model.Goals[index].Goal.DataType == GoalDataType.Scale)
                                {
                                    <span class="rm-field__hint">@Localizer["DataTypeScaleHelp"]</span>
                                }
                            </RmField>

                            @if (_model.Goals[index].Goal.DataType != GoalDataType.Boolean)
                            {
                                <RmField Label="@Localizer["GoalUnitLabel"]">
                                    <InputText class="rm-input" @bind-Value="_model.Goals[index].Goal.Unit" />
                                </RmField>
                            }

                            @if (_model.Goals[index].Goal.DataType != GoalDataType.Boolean)
                            {
                                <RmField Label="@Localizer["GoalMinValueLabel"]">
                                    <RmNumberInput DataType="_model.Goals[index].Goal.DataType"
                                                   @bind-Value="_model.Goals[index].Goal.MinValue"
                                                   aria-label="@Localizer["GoalMinValueLabel"]" />
                                </RmField>

                                <RmField Label="@Localizer["GoalMaxValueLabel"]">
                                    <RmNumberInput DataType="_model.Goals[index].Goal.DataType"
                                                   @bind-Value="_model.Goals[index].Goal.MaxValue"
                                                   aria-label="@Localizer["GoalMaxValueLabel"]" />
                                </RmField>
                            }
                        </div>

                        @if (_model.Goals[index].Goal.DataType != GoalDataType.Boolean)
                        {
                            <div class="goal__targets">
                                <RmCard Flat="true" Class="goal__target">
                                    <h3 class="goal__target-title">@Localizer["GoalCreatorTargetTitle"]</h3>
                                    <div class="goal__target-grid">
                                        <RmField Label="@Localizer["GoalBaselineLabel"]">
                                            <RmNumberInput DataType="_model.Goals[index].Goal.DataType"
                                                           @bind-Value="_model.Goals[index].CreatorTarget.Baseline"
                                                           aria-label="@Localizer["GoalBaselineLabel"]" />
                                        </RmField>

                                        <RmField Label="@Localizer["GoalTargetValueLabel"]">
                                            <RmNumberInput DataType="_model.Goals[index].Goal.DataType"
                                                           @bind-Value="_model.Goals[index].CreatorTarget.TargetValue"
                                                           aria-label="@Localizer["GoalTargetValueLabel"]" />
                                        </RmField>

                                        <RmField Label="@Localizer["GoalDirectionLabel"]">
                                            <InputSelect class="rm-select" @bind-Value="_model.Goals[index].CreatorTarget.Direction">
                                                @if (_model.Goals[index].Goal.DataType == GoalDataType.Scale)
                                                {
                                                    <option value="@GoalDirection.Increase">@Localizer["DirectionIncrease"]</option>
                                                    <option value="@GoalDirection.Reach">@Localizer["DirectionReach"]</option>
                                                }
                                                else
                                                {
                                                    <option value="@GoalDirection.Decrease">@Localizer["DirectionDecrease"]</option>
                                                    <option value="@GoalDirection.Increase">@Localizer["DirectionIncrease"]</option>
                                                    <option value="@GoalDirection.Reach">@Localizer["DirectionReach"]</option>
                                                    <option value="@GoalDirection.Maintain">@Localizer["DirectionMaintain"]</option>
                                                }
                                            </InputSelect>
                                        </RmField>
                                    </div>
                                </RmCard>

                                <RmCard Flat="true" Class="goal__target">
                                    <h3 class="goal__target-title">@Localizer["GoalSuggestedPartnerTargetTitle"]</h3>
                                    <div class="goal__target-grid">
                                        <RmField Label="@Localizer["GoalBaselineLabel"]">
                                            <RmNumberInput DataType="_model.Goals[index].Goal.DataType"
                                                           @bind-Value="_model.Goals[index].SuggestedPartnerTarget!.Baseline"
                                                           aria-label="@Localizer["GoalBaselineLabel"]" />
                                        </RmField>

                                        <RmField Label="@Localizer["GoalTargetValueLabel"]">
                                            <RmNumberInput DataType="_model.Goals[index].Goal.DataType"
                                                           @bind-Value="_model.Goals[index].SuggestedPartnerTarget!.TargetValue"
                                                           aria-label="@Localizer["GoalTargetValueLabel"]" />
                                        </RmField>

                                        <RmField Label="@Localizer["GoalDirectionLabel"]">
                                            <InputSelect class="rm-select" @bind-Value="_model.Goals[index].SuggestedPartnerTarget!.Direction">
                                                @if (_model.Goals[index].Goal.DataType == GoalDataType.Scale)
                                                {
                                                    <option value="@GoalDirection.Increase">@Localizer["DirectionIncrease"]</option>
                                                    <option value="@GoalDirection.Reach">@Localizer["DirectionReach"]</option>
                                                }
                                                else
                                                {
                                                    <option value="@GoalDirection.Decrease">@Localizer["DirectionDecrease"]</option>
                                                    <option value="@GoalDirection.Increase">@Localizer["DirectionIncrease"]</option>
                                                    <option value="@GoalDirection.Reach">@Localizer["DirectionReach"]</option>
                                                    <option value="@GoalDirection.Maintain">@Localizer["DirectionMaintain"]</option>
                                                }
                                            </InputSelect>
                                        </RmField>
                                    </div>
                                </RmCard>
                            </div>
                        }
                    </RmCard>
                }

                <RmButton Variant="outline" @onclick="AddGoal">
                    <RmIcon Name="plus" />
                    @Localizer["AddGoalButton"]
                </RmButton>
            </div>

            <div class="create__step" hidden="@(_step != 2)">
                <RmCard>
                    <div class="create__summary-head">
                        <span class="rm-icon-tile rm-icon-tile--lg">@(_model.Icon ?? "🎯")</span>
                        <div>
                            <p class="create__summary-name">@(string.IsNullOrWhiteSpace(_model.Name) ? Localizer["CreateProjectUnnamed"] : _model.Name)</p>
                            <p class="create__summary-meta">
                                @_model.StartDate.ToString("dd/MM/yyyy") — @_model.EndDate.ToString("dd/MM/yyyy")
                                · @Localizer["ProjectGoalCount", _model.Goals.Count]
                            </p>
                        </div>
                    </div>
                    <p class="create__summary-text">@Localizer["CreateProjectInviteHint"]</p>
                </RmCard>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <RmAlert Tone="danger" Class="mt-3">@_error</RmAlert>
                }
            </div>

            <div class="create__actions">
                @if (_step == 0)
                {
                    <RmButton Href="/projects" Variant="outline">@Localizer["Cancel"]</RmButton>
                }
                else
                {
                    <RmButton Variant="outline" @onclick="() => _step--">
                        <RmIcon Name="arrow-left" />
                        @Localizer["StepBack"]
                    </RmButton>
                }

                @if (_step < Steps.Length - 1)
                {
                    <RmButton @onclick="() => _step++">
                        @Localizer["StepNext"]
                        <RmIcon Name="arrow-right" />
                    </RmButton>
                }
                else
                {
                    <button type="submit" class="rm-btn rm-btn--primary" disabled="@_isLoading">
                        @(_isLoading ? Localizer["Creating"] : Localizer["CreateProjectButton"])
                    </button>
                }
            </div>
        </EditForm>
    }
</div>

@code {
    private static readonly string[] IconChoices = ["🌊", "🏃", "💪", "🥗", "🧘", "🚴", "🏋️", "🎯"];

    private CreateProjectRequest _model = new();
    private string? _error;
    private bool _isLoading;
    private bool _success;
    private int _step;
    private Guid _createdProjectId;

    private (int Index, string Icon, string Label)[] Steps =>
    [
        (0, "pencil", Localizer["CreateStepDetails"]),
        (1, "target", Localizer["GoalsSectionTitle"]),
        (2, "mail", Localizer["CreateStepInvite"])
    ];

    protected override void OnInitialized()
    {
        if (_model.Goals.Count == 0)
        {
            _model.Goals.Add(CreateDefaultGoalRequest());
        }

        _model.Icon ??= IconChoices[0];
    }

    private void AddGoal()
    {
        _model.Goals.Add(CreateDefaultGoalRequest());
    }

    private static CreateProjectGoalRequest CreateDefaultGoalRequest()
    {
        var creator = new GoalTargetRequest();
        return new CreateProjectGoalRequest
        {
            Goal = new GoalFieldRequest(),
            CreatorTarget = creator,
            SuggestedPartnerTarget = Copy(creator)
        };
    }

    private static GoalTargetRequest Copy(GoalTargetRequest source) =>
        new()
        {
            Baseline = source.Baseline,
            TargetValue = source.TargetValue,
            Direction = source.Direction
        };

    private void RemoveGoal(int index)
    {
        if (_model.Goals.Count > 1)
        {
            _model.Goals.RemoveAt(index);
        }
    }

    private async Task HandleSubmit()
    {
        _isLoading = true;
        _error = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userIdStr = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            if (userIdStr is null || !Guid.TryParse(userIdStr, out var userId))
            {
                _error = Localizer["CreateProjectError"];
                return;
            }

            var goals = _model.Goals.Select(g => new GoalFieldInput(
                g.Goal.Label,
                g.Goal.DataType,
                g.Goal.Unit,
                g.Goal.MinValue,
                g.Goal.MaxValue,
                new GoalTargetInput(
                    g.CreatorTarget.Baseline,
                    g.CreatorTarget.TargetValue,
                    g.CreatorTarget.Direction),
                g.SuggestedPartnerTarget is null
                    ? null
                    : new GoalTargetInput(
                        g.SuggestedPartnerTarget.Baseline,
                        g.SuggestedPartnerTarget.TargetValue,
                        g.SuggestedPartnerTarget.Direction)));

            var project = await ProjectService.CreateProjectAsync(
                userId, _model.Name, _model.StartDate, _model.EndDate,
                _model.Frequency, goals, _model.Icon);

            _createdProjectId = project.Id;
            _success = true;
        }
        catch (GoalValueException ex)
        {
            _error = GoalValueMessage(ex.Error, ex.GoalLabel, ex.MinValue, ex.MaxValue, ex.DataType);
            _step = Steps.Length - 1;
        }
        catch (ArgumentException ex)
        {
            _error = ex.Message;
            _step = Steps.Length - 1;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to create project");
            _error = Localizer["CreateProjectError"];
            _step = Steps.Length - 1;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OnDataTypeChanged(int index, ChangeEventArgs e)
    {
        if (!Enum.TryParse<GoalDataType>(e.Value?.ToString(), out var value))
            return;

        _model.Goals[index].Goal.DataType = value;

        if (value == GoalDataType.Boolean)
        {
            _model.Goals[index].Goal.Unit = string.Empty;
            _model.Goals[index].Goal.MinValue = 0m;
            _model.Goals[index].Goal.MaxValue = 1m;
            _model.Goals[index].CreatorTarget.Baseline = 0m;
            _model.Goals[index].CreatorTarget.TargetValue = 1m;
            _model.Goals[index].CreatorTarget.Direction = GoalDirection.Reach;
            _model.Goals[index].SuggestedPartnerTarget!.Baseline = 0m;
            _model.Goals[index].SuggestedPartnerTarget!.TargetValue = 1m;
            _model.Goals[index].SuggestedPartnerTarget!.Direction = GoalDirection.Reach;
        }
        else if (value == GoalDataType.Scale)
        {
            _model.Goals[index].Goal.MinValue ??= 1m;
            _model.Goals[index].Goal.MaxValue ??= 5m;
            _model.Goals[index].CreatorTarget.Baseline ??= _model.Goals[index].Goal.MinValue;
            _model.Goals[index].CreatorTarget.TargetValue ??= _model.Goals[index].Goal.MaxValue;
            _model.Goals[index].SuggestedPartnerTarget!.Baseline ??= _model.Goals[index].Goal.MinValue;
            _model.Goals[index].SuggestedPartnerTarget!.TargetValue ??= _model.Goals[index].Goal.MaxValue;

            if (_model.Goals[index].CreatorTarget.Direction is GoalDirection.Decrease or GoalDirection.Maintain)
                _model.Goals[index].CreatorTarget.Direction = GoalDirection.Reach;

            if (_model.Goals[index].SuggestedPartnerTarget!.Direction is GoalDirection.Decrease or GoalDirection.Maintain)
                _model.Goals[index].SuggestedPartnerTarget!.Direction = GoalDirection.Reach;
        }
    }

    private string GoalValueMessage(
        GoalValueError error, string label, decimal? min, decimal? max, GoalDataType dataType) => error switch
    {
        GoalValueError.NotInteger => Localizer["GoalValueNotInteger", label],
        GoalValueError.PercentOutOfRange => Localizer["GoalValuePercentOutOfRange", label],
        GoalValueError.BelowMinimum => Localizer["GoalValueBelowMinimum", label, DecimalInput.ToDisplay(min, dataType)],
        GoalValueError.AboveMaximum => Localizer["GoalValueAboveMaximum", label, DecimalInput.ToDisplay(max, dataType)],
        GoalValueError.TargetInconsistentWithDirection => Localizer["GoalValueTargetInconsistent", label],
        GoalValueError.BooleanOutOfRange => Localizer["GoalValueBooleanOutOfRange", label],
        GoalValueError.BooleanInvalidDirection => Localizer["GoalValueBooleanInvalidDirection", label],
        GoalValueError.ScaleInvalidDirection => Localizer["GoalValueScaleInvalidDirection", label],
        GoalValueError.BooleanTargetValueInvalid => Localizer["GoalValueBooleanTargetValueInvalid", label],
        GoalValueError.ScaleBoundsInvalid => Localizer["GoalValueScaleBoundsInvalid", label],
        _ => Localizer["GoalValueInvalid", label]
    };
}
