@page "/invitations/{Token}"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IProjectService ProjectService
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> Localizer
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<InvitationAccept> Logger

<PageTitle>@Localizer["InvitationTitle"]</PageTitle>

@if (_loading)
{
    <div class="skeleton" style="width: 60%; height: 2rem; margin-bottom: 1.5rem;"></div>
    <div class="skeleton" style="width: 100%; height: 6rem; margin-bottom: 1.5rem;"></div>
    <div class="skeleton" style="width: 100%; height: 8rem;"></div>
}
else if (_error is not null)
{
    <FluentMessageBar Intent="MessageIntent.Error" Title="@_error" AllowDismiss="false" />
    <FluentButton Appearance="Appearance.Neutral" OnClick="@(() => Navigation.NavigateTo("/"))" Class="mt-3">
        @Localizer["BackToHome"]
    </FluentButton>
}
else if (_accepted && _project is not null)
{
    <FluentMessageBar Intent="MessageIntent.Success" Title="@Localizer["InvitationAccepted"]" AllowDismiss="false" />

    <h3>@_project.Name</h3>

    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="16" Style="flex-wrap: wrap; margin-bottom: 1rem;" VerticalGap="8">
        <span><strong>@Localizer["StatusLabel"]:</strong> @GetStatusText(_project.Status)</span>
        <span><strong>@Localizer["StartDateLabel"]:</strong> @_project.StartDate.ToString("yyyy-MM-dd")</span>
        <span><strong>@Localizer["EndDateLabel"]:</strong> @_project.EndDate.ToString("yyyy-MM-dd")</span>
        <span><strong>@Localizer["FrequencyLabel"]:</strong> @GetFrequencyText(_project.Frequency)</span>
    </FluentStack>

    <h4>@Localizer["GoalsSectionTitle"]</h4>
    <FluentDataGrid Items="@_project.Goals.AsQueryable()" TGridItem="GoalField" AutoFit="true" Style="margin-bottom: 1.5rem;">
        <PropertyColumn Property="@((GoalField g) => g.Label)" Title="@Localizer["GoalFieldLabel"]" />
        <PropertyColumn Property="@((GoalField g) => g.DataType)" Title="@Localizer["GoalDataTypeLabel"]" />
        <PropertyColumn Property="@((GoalField g) => g.Unit)" Title="@Localizer["GoalUnitLabel"]" />
        <PropertyColumn Property="@((GoalField g) => g.MinValue)" Title="@Localizer["GoalMinValueLabel"]" />
        <PropertyColumn Property="@((GoalField g) => g.MaxValue)" Title="@Localizer["GoalMaxValueLabel"]" />
        <PropertyColumn Property="@((GoalField g) => g.TargetValue)" Title="@Localizer["GoalTargetValueLabel"]" />
    </FluentDataGrid>

    @if (_project.Status == Core.Enums.ProjectStatus.Pending)
    {
        <FluentCard Class="mb-3">
            <h5 style="margin-top: 0;">@Localizer["ApproveProjectTitle"]</h5>
            <p>@Localizer["ApproveProjectDescription"]</p>
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12">
                <FluentButton Appearance="Appearance.Accent" Disabled="@_actionLoading" Loading="@_actionLoading" OnClick="HandleApproveProject">
                    @Localizer["ApproveButton"]
                </FluentButton>
                <FluentAnchor Href="@($"/projects/{_project.Id}")" Appearance="Appearance.Outline">
                    @Localizer["ProposeChangeButton"]
                </FluentAnchor>
            </FluentStack>
        </FluentCard>
    }

    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <FluentMessageBar Intent="@_statusMessageIntent" Title="@_statusMessage" AllowDismiss="false" Class="mb-3" />
    }

    <FluentAnchor Href="@($"/projects/{_project.Id}")" Appearance="Appearance.Neutral">
        @Localizer["ViewProjectDetails"]
    </FluentAnchor>
}
else
{
    <FluentCard>
        <h4 style="margin-top: 0;">@Localizer["InvitationTitle"]</h4>
        <p>@Localizer["InvitationPreviewText"]</p>

        @if (_project is not null)
        {
            <h5>@_project.Name</h5>
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="16" Style="flex-wrap: wrap; margin-bottom: 1rem;" VerticalGap="8">
                <span><strong>@Localizer["StartDateLabel"]:</strong> @_project.StartDate.ToString("yyyy-MM-dd")</span>
                <span><strong>@Localizer["EndDateLabel"]:</strong> @_project.EndDate.ToString("yyyy-MM-dd")</span>
                <span><strong>@Localizer["FrequencyLabel"]:</strong> @GetFrequencyText(_project.Frequency)</span>
            </FluentStack>

            <h6 style="margin-bottom: 0.5rem;">@Localizer["GoalsSectionTitle"]</h6>
            <ul style="margin-bottom: 1rem; padding-left: 1.25rem;">
                @foreach (var goal in _project.Goals)
                {
                    <li>@goal.Label (@goal.Unit) - @Localizer["GoalTargetValueLabel"]: @goal.TargetValue</li>
                }
            </ul>

            <FluentButton Appearance="Appearance.Accent" Disabled="@_actionLoading" Loading="@_actionLoading" OnClick="HandleAcceptInvitation">
                @(_actionLoading ? Localizer["Processing"] : Localizer["AcceptInvitationButton"])
            </FluentButton>
        }
    </FluentCard>
}

@code {
    [Parameter]
    public string Token { get; set; } = string.Empty;

    private Core.Entities.Project? _project;
    private Guid _currentUserId;
    private bool _loading = true;
    private bool _accepted;
    private bool _actionLoading;
    private string? _error;
    private string? _statusMessage;
    private MessageIntent _statusMessageIntent = MessageIntent.Info;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdStr = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (userIdStr is null || !Guid.TryParse(userIdStr, out _currentUserId))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            _project = await TryPreviewProject();

            if (_project is null)
            {
                _error = Localizer["InvitationInvalidOrExpired"];
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load invitation preview");
            _error = Localizer["InvitationError"];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task<Core.Entities.Project?> TryPreviewProject()
    {
        try
        {
            return await ProjectService.GetInvitationProjectAsync(Token);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load invitation preview");
            return null;
        }
    }

    private async Task HandleAcceptInvitation()
    {
        _actionLoading = true;
        _error = null;

        try
        {
            var result = await ProjectService.AcceptInvitationAsync(Token, _currentUserId);
            if (result is null)
            {
                _error = Localizer["InvitationInvalidOrExpired"];
            }
            else
            {
                _project = result;
                _accepted = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to accept invitation for user {UserId}", _currentUserId);
            _error = Localizer["InvitationError"];
        }
        finally
        {
            _actionLoading = false;
        }
    }

    private async Task HandleApproveProject()
    {
        var dialog = await DialogService.ShowConfirmationAsync(
            @Localizer["ApproveProjectDescription"],
            primaryText: @Localizer["ApproveButton"],
            secondaryText: @Localizer["Cancel"],
            title: @Localizer["ConfirmApproveTitle"]);

        var result = await dialog.Result;
        if (result.Cancelled)
            return;

        _actionLoading = true;
        _statusMessage = null;

        try
        {
            if (_project is null) return;
            await ProjectService.ApproveProjectAsync(_project.Id, _currentUserId);
            _project = await ProjectService.GetProjectAsync(_project.Id, _currentUserId);
            _statusMessage = Localizer["ProjectApprovedSuccess"];
            _statusMessageIntent = MessageIntent.Success;
        }
        catch (Exception ex)
        {
            _statusMessage = ex.Message;
            _statusMessageIntent = MessageIntent.Error;
        }
        finally
        {
            _actionLoading = false;
        }
    }

    private string GetStatusText(Core.Enums.ProjectStatus status) => status switch
    {
        Core.Enums.ProjectStatus.Pending => Localizer["StatusPending"],
        Core.Enums.ProjectStatus.Active => Localizer["StatusActive"],
        Core.Enums.ProjectStatus.Finished => Localizer["StatusFinished"],
        Core.Enums.ProjectStatus.Cancelled => Localizer["StatusCancelled"],
        _ => status.ToString()
    };

    private string GetFrequencyText(Core.Enums.ProjectFrequency freq) => freq switch
    {
        Core.Enums.ProjectFrequency.Daily => Localizer["FrequencyDaily"],
        Core.Enums.ProjectFrequency.Weekly => Localizer["FrequencyWeekly"],
        Core.Enums.ProjectFrequency.Biweekly => Localizer["FrequencyBiweekly"],
        Core.Enums.ProjectFrequency.Monthly => Localizer["FrequencyMonthly"],
        _ => freq.ToString()
    };
}
