@using ResponsabiliMano.Core.Enums

@code {
    [Parameter] public Feeling Feeling { get; set; }
    [Parameter] public int Size { get; set; } = 48;
    [Parameter] public string? Class { get; set; }

    // Reads from the design tokens so the scale re-tints with the theme: the low end
    // borrows the partner warm, the high end the brand green.
    private string Color => Feeling switch
    {
        Feeling.VerySad => "var(--rm-partner)",
        Feeling.Sad => "var(--rm-chart-4)",
        Feeling.Neutral => "var(--rm-muted-fg)",
        Feeling.Happy => "var(--rm-chart-3)",
        Feeling.VeryHappy => "var(--rm-primary)",
        _ => "var(--rm-muted-fg)"
    };

    // A filled circle in the feeling's color with white features — bold, friendly,
    // and legible at small sizes (design-brief "faces coloridas"). {0} = fill color.
    private string SvgContent => Feeling switch
    {
        Feeling.VerySad => """
            <circle cx="12" cy="12" r="11" fill="{0}" />
            <path d="M7 10 L10 11.6" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" />
            <path d="M17 10 L14 11.6" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" />
            <path d="M8 17 Q12 13 16 17" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" />
            """,
        Feeling.Sad => """
            <circle cx="12" cy="12" r="11" fill="{0}" />
            <circle cx="9" cy="10.5" r="1.3" fill="#fff" />
            <circle cx="15" cy="10.5" r="1.3" fill="#fff" />
            <path d="M8 16.5 Q12 13.5 16 16.5" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" />
            """,
        Feeling.Neutral => """
            <circle cx="12" cy="12" r="11" fill="{0}" />
            <circle cx="9" cy="10.5" r="1.3" fill="#fff" />
            <circle cx="15" cy="10.5" r="1.3" fill="#fff" />
            <line x1="8.5" y1="15.5" x2="15.5" y2="15.5" stroke="#fff" stroke-width="1.8" stroke-linecap="round" />
            """,
        Feeling.Happy => """
            <circle cx="12" cy="12" r="11" fill="{0}" />
            <circle cx="9" cy="10.5" r="1.3" fill="#fff" />
            <circle cx="15" cy="10.5" r="1.3" fill="#fff" />
            <path d="M8 14.5 Q12 17.5 16 14.5" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" />
            """,
        Feeling.VeryHappy => """
            <circle cx="12" cy="12" r="11" fill="{0}" />
            <path d="M7 10.5 Q9 9 11 10.5" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" />
            <path d="M13 10.5 Q15 9 17 10.5" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" />
            <path d="M7.5 13.5 Q12 18.5 16.5 13.5" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" />
            """,
        _ => """
            <circle cx="12" cy="12" r="11" fill="{0}" />
            <circle cx="9" cy="10.5" r="1.3" fill="#fff" />
            <circle cx="15" cy="10.5" r="1.3" fill="#fff" />
            <line x1="8.5" y1="15.5" x2="15.5" y2="15.5" stroke="#fff" stroke-width="1.8" stroke-linecap="round" />
            """
    };

    private MarkupString RenderSvg()
    {
        var content = string.Format(SvgContent, Color);
        var svg = $"""
            <svg class="{Class}" width="{Size}" height="{Size}" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="display:block;">
              {content}
            </svg>
            """;
        return new MarkupString(svg);
    }
}

@((MarkupString)RenderSvg())
