@page "/register"
@attribute [AllowAnonymous]
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>@Localizer["RegisterTitle"]</PageTitle>

<h3>@Localizer["RegisterTitle"]</h3>

@if (!string.IsNullOrEmpty(Error))
{
    <div class="alert alert-danger" role="alert">@Localizer["RegisterError"]</div>
}

<form method="post" action="/api/auth/register-and-login" class="mb-3">
    <div class="mb-3">
        <label for="name" class="form-label">@Localizer["NameLabel"]</label>
        <input id="name" name="Name" class="form-control" required maxlength="200" />
    </div>

    <div class="mb-3">
        <label for="email" class="form-label">@Localizer["EmailLabel"]</label>
        <input id="email" name="Email" type="email" class="form-control" required />
    </div>

    <div class="mb-3">
        <label for="password" class="form-label">@Localizer["PasswordLabel"]</label>
        <input id="password" name="Password" type="password" class="form-control" required minlength="8" />
    </div>

    <div class="mb-3">
        <label for="confirmPassword" class="form-label">@Localizer["ConfirmPasswordLabel"]</label>
        <input id="confirmPassword" name="ConfirmPassword" type="password" class="form-control" required minlength="8" />
    </div>

    <button type="submit" class="btn btn-primary">@Localizer["RegisterButton"]</button>
</form>

<p>@Localizer["AlreadyHaveAccount"] <a href="/login">@Localizer["LoginButton"]</a></p>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? Error { get; set; }
}
