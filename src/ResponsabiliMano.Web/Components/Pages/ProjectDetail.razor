@page "/projects/{ProjectId:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IProjectService ProjectService
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> Localizer
@inject AuthenticationStateProvider AuthStateProvider
@inject IFeatureManager FeatureManager
@inject ILogger<ProjectDetail> Logger
@using Microsoft.FeatureManagement
@using ResponsabiliMano.Core.Entities
@using System.Text.Json

<PageTitle>@Localizer["ProjectDetailTitle"]</PageTitle>

@if (_loading)
{
    <div class="skeleton detail__skeleton detail__skeleton--head"></div>
    <div class="skeleton detail__skeleton detail__skeleton--actions"></div>
    <div class="skeleton detail__skeleton detail__skeleton--body"></div>
}
else if (_project is null)
{
    <RmAlert Tone="danger">@Localizer["ProjectNotFound"]</RmAlert>
    <RmButton Href="/projects" Variant="outline" Class="mt-3">@Localizer["BackToHome"]</RmButton>
}
else
{
    <AutoRefresh IntervalSeconds="5" OnRefresh="RefreshAsync" />

    <a href="/projects" class="rm-back-link">
        <RmIcon Name="arrow-left" Size="0.875rem" />
        @Localizer["MyProjectsTitle"]
    </a>

    @* Hero: identity, status and the pair, all above the fold. *@
    <RmCard Class="detail__hero">
        <div class="detail__identity">
            <span class="rm-icon-tile rm-icon-tile--lg rm-icon-tile--accent detail__emoji">@(_project.Icon ?? "🎯")</span>
            <div>
                <RmBadge Tone="@StatusTone(_project.Status)" Dot="true">@GetStatusText(_project.Status)</RmBadge>
                <h1 class="detail__title">@_project.Name</h1>
                <div class="detail__meta">
                    <span>
                        <RmIcon Name="calendar" Size="0.875rem" />
                        @_project.StartDate.ToString("dd MMM yyyy") — @_project.EndDate.ToString("dd MMM yyyy")
                    </span>
                    <span>
                        <RmIcon Name="repeat" Size="0.875rem" />
                        @GetFrequencyText(_project.Frequency)
                    </span>
                </div>
            </div>
        </div>

        @* No dashboard button here: the "compare progress" card below is the single
           entry point to this project's panel. *@
        <div class="detail__people">
            <RmAvatarStack You="@_project.Creator?.Name" Partner="@_project.Partner?.Name" Soft="true" />
        </div>
    </RmCard>

    @if (_project.Status == Core.Enums.ProjectStatus.Active)
    {
        <div class="detail__quick">
            @if (_checkInsEnabled)
            {
                <a class="rm-card rm-card--flat rm-card--interactive quick" href="@($"/projects/{_project.Id}/checkin")">
                    <RmIconTile Size="sm">
                        <RmIcon Name="clipboard-check" Size="1.125rem" />
                    </RmIconTile>
                    <div class="quick__text">
                        <p class="quick__title">@Localizer["CheckInButton"]</p>
                        <p class="quick__sub">@GetFrequencyText(_project.Frequency)</p>
                    </div>
                    <RmIcon Name="chevron-right" Class="quick__chevron" />
                </a>
            }

            @if (_dashboardEnabled)
            {
                <a class="rm-card rm-card--flat rm-card--interactive quick" href="@($"/projects/{_project.Id}/dashboard")">
                    <RmIconTile Tone="partner" Size="sm">
                        <RmIcon Name="trending-up" Size="1.125rem" />
                    </RmIconTile>
                    <div class="quick__text">
                        <p class="quick__title">@Localizer["DashboardCompareTitle"]</p>
                        <p class="quick__sub" data-test="dashboard-compare-text">@Localizer["DashboardCompareText", GetDashboardComparePartnerName()]</p>
                    </div>
                    <RmIcon Name="chevron-right" Class="quick__chevron" />
                </a>
            }
        </div>

        <StreakIndicator CurrentStreak="_streak.Current" BestStreak="_streak.Best" />
    }

    @if (_project.Partner is null && _project.CreatorId == _currentUserId)
    {
        <RmCard Class="detail__invite">
            <div>
                <p class="detail__invite-title">@Localizer["NoPartnerYet"]</p>
                <p class="detail__invite-text">@Localizer["CreateProjectInviteHint"]</p>
            </div>
            <RmButton Href="@($"/projects/{_project.Id}/invite")">@Localizer["InvitePartnerButton"]</RmButton>
        </RmCard>
    }

    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <RmAlert Tone="@_statusTone" Class="mt-3">@_statusMessage</RmAlert>
    }



    <div class="tabs" role="tablist">
        @foreach (var tab in Tabs)
        {
            <button type="button" role="tab"
                    class="tabs__trigger @(_tab == tab.Index ? "is-active" : null)"
                    aria-selected="@(_tab == tab.Index)"
                    @onclick="() => _tab = tab.Index">
                <RmIcon Name="@tab.Icon" Size="0.875rem" />
                @tab.Label
            </button>
        }
    </div>

    @if (_tab == 0)
    {
        @if (_project.PartnerId is not null)
        {
            <GoalNegotiationPanel ProjectId="ProjectId" CurrentUserId="_currentUserId" OnChanged="RefreshAsync" />
        }
        else
        {
            <div class="goals">
                @foreach (var goal in _project.Goals)
                {
                    var mine = GetTargetFor(goal, _currentUserId);
                    var partner = GetPartnerTargetFor(goal);
                    <RmCard Flat="true" Class="goal-tile">
                        <p class="goal-tile__label">@goal.Label</p>
                        <p class="goal-tile__target rm-display rm-tabular">
                            <GoalValueDisplay Value="mine?.TargetValue" DataType="goal.DataType" Unit="goal.Unit" MinValue="goal.MinValue" MaxValue="goal.MaxValue" />
                        </p>
                        <p class="goal-tile__target-label">@Localizer["ProjectGoalTargetMine"]</p>
                        @if (partner is not null)
                        {
                            <p class="goal-tile__partner-target rm-display rm-tabular">
                                <GoalValueDisplay Value="partner?.TargetValue" DataType="goal.DataType" Unit="goal.Unit" MinValue="goal.MinValue" MaxValue="goal.MaxValue" />
                            </p>
                            <p class="goal-tile__target-label">@Localizer["ProjectGoalTargetPartner"]</p>
                        }
                        @if (goal.MinValue is not null || goal.MaxValue is not null)
                        {
                            <p class="goal-tile__range">@DecimalInput.ToDisplay(goal.MinValue, goal.DataType) … @DecimalInput.ToDisplay(goal.MaxValue, goal.DataType) @goal.Unit</p>
                        }
                    </RmCard>
                }
            </div>
        }
    }
    else if (_tab == 1)
    {
        @if (_project.ChangeRequests.Count == 0)
        {
            <RmEmptyState Icon="repeat" Title="@Localizer["NoChangeRequests"]" />
        }
        else
        {
            <div class="rm-stack">
                @foreach (var cr in _project.ChangeRequests.OrderByDescending(c => c.CreatedAt))
                {
                    <RmCard Flat="true" Class="cr">
                        <RmAvatar Name="@(cr.RequestedByUserId == _project.CreatorId ? _project.Creator?.Name : _project.Partner?.Name)"
                                  Tone="@(cr.RequestedByUserId == _project.CreatorId ? "you-soft" : "partner-soft")" />
                        <div class="cr__text">
                            <p class="cr__type">@GetChangeRequestTypeText(cr.Type)</p>
                            <p class="cr__meta">
                                @(cr.RequestedByUserId == _project.CreatorId ? _project.Creator?.Name : _project.Partner?.Name)
                                · @cr.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </p>
                            @if (cr.Type == Core.Enums.ChangeRequestType.Goals)
                            {
                                <div class="cr__summary" data-test="change-request-summary">
                                    <GoalChangeDiff CurrentGoals="_project.Goals" PayloadJson="@cr.PayloadJson" Localizer="Localizer" />
                                </div>
                            }
                            else
                            {
                                <p class="cr__summary" data-test="change-request-summary">@GetChangeRequestSummary(cr)</p>
                            }
                        </div>

                        <RmBadge Tone="@CrTone(cr.Status)">@GetChangeRequestStatusText(cr.Status)</RmBadge>

                        @if (cr.Status == Core.Enums.ChangeRequestStatus.Pending && cr.RequestedByUserId != _currentUserId)
                        {
                            <div class="cr__actions">
                                <RmButton Size="sm" Disabled="_actionLoading" @onclick="() => HandleRespondToChangeRequest(cr.Id, true)">
                                    <RmIcon Name="check" />
                                    @Localizer["ApproveButton"]
                                </RmButton>
                                <RmButton Size="sm" Variant="outline" Disabled="_actionLoading" @onclick="() => HandleRespondToChangeRequest(cr.Id, false)">
                                    <RmIcon Name="x" />
                                    @Localizer["RejectButton"]
                                </RmButton>
                            </div>
                        }
                    </RmCard>
                }
            </div>
        }
    }
    else if (_tab == 2 && _project.Status is Core.Enums.ProjectStatus.Pending or Core.Enums.ProjectStatus.Active)
    {
        <RmCard>
            <h2 class="propose__title">@Localizer["ProposeChangeTitle"]</h2>

            <RmField Label="@Localizer["ChangeTypeLabel"]" For="changeType" Class="mt-3">
                <select id="changeType" class="rm-select propose__select"
                        value="@_proposeType"
                        @onchange="e => _proposeType = Enum.Parse<ChangeRequestType>(e.Value?.ToString() ?? string.Empty)">
                    <option value="@ChangeRequestType.EndDate">@Localizer["ChangeTypeEndDate"]</option>
                    <option value="@ChangeRequestType.Frequency">@Localizer["ChangeTypeFrequency"]</option>
                </select>
            </RmField>

            @if (_proposeType == Core.Enums.ChangeRequestType.EndDate)
            {
                <RmField Label="@Localizer["NewEndDateLabel"]" For="newEndDate" Class="mt-3">
                    <input id="newEndDate" type="date" class="rm-input propose__select"
                           value="@_proposeEndDate?.ToString("yyyy-MM-dd")"
                           @onchange="e => _proposeEndDate = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : null" />
                </RmField>
            }
            else if (_proposeType == Core.Enums.ChangeRequestType.Frequency)
            {
                <RmField Label="@Localizer["NewFrequencyLabel"]" For="newFrequency" Class="mt-3">
                    <select id="newFrequency" class="rm-select propose__select"
                            value="@_proposeFrequency"
                            @onchange="e => _proposeFrequency = Enum.Parse<ProjectFrequency>(e.Value?.ToString() ?? string.Empty)">
                        <option value="@ProjectFrequency.Daily">@Localizer["FrequencyDaily"]</option>
                        <option value="@ProjectFrequency.Weekly">@Localizer["FrequencyWeekly"]</option>
                        <option value="@ProjectFrequency.Biweekly">@Localizer["FrequencyBiweekly"]</option>
                        <option value="@ProjectFrequency.Monthly">@Localizer["FrequencyMonthly"]</option>
                    </select>
                </RmField>
            }


            @if (!string.IsNullOrEmpty(_proposeError))
            {
                <RmAlert Tone="danger" Class="mt-3">@_proposeError</RmAlert>
            }

            <RmButton Disabled="_actionLoading" @onclick="HandleProposeChange" Class="mt-3">
                @(_actionLoading ? Localizer["Processing"] : Localizer["ProposeChangeButton"])
            </RmButton>
        </RmCard>
    }

    <RmConfirmDialog @ref="_confirmDialog"
                     Title="@_confirmTitle"
                     Message="@_confirmMessage"
                     ConfirmText="@_confirmAction"
                     CancelText="@Localizer["Cancel"]" />
}

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    private Core.Entities.Project? _project;
    private Guid _currentUserId;
    private bool _loading = true;
    private bool _checkInsEnabled;
    private bool _dashboardEnabled;
    private bool _actionLoading;
    private int _tab;
    private string? _statusMessage;
    private string _statusTone = "info";
    private string? _proposeError;
    private (int Current, int Best) _streak;

    private RmConfirmDialog? _confirmDialog;
    private string? _confirmTitle;
    private string? _confirmMessage;
    private string? _confirmAction;

    private Core.Enums.ChangeRequestType _proposeType = Core.Enums.ChangeRequestType.EndDate;
    private DateTime? _proposeEndDate;
    private Core.Enums.ProjectFrequency _proposeFrequency = Core.Enums.ProjectFrequency.Weekly;

    private (int Index, string Icon, string Label)[] Tabs =>
    [
        (0, "target", Localizer["GoalsSectionTitle"]),
        (1, "repeat", Localizer["ChangeRequestsTitle"]),
        (2, "pencil", Localizer["ProposeChangeTitle"])
    ];

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _checkInsEnabled = await FeatureManager.IsEnabledAsync(FeatureFlags.CheckIns);
        _dashboardEnabled = await FeatureManager.IsEnabledAsync(FeatureFlags.Dashboard);
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdStr = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (userIdStr is null || !Guid.TryParse(userIdStr, out _currentUserId))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            _project = await ProjectService.GetProjectAsync(ProjectId, _currentUserId);
            if (_project is not null)
            {
                _proposeEndDate = _project.EndDate;
                _proposeFrequency = _project.Frequency;

                if (_project.Status == Core.Enums.ProjectStatus.Active)
                {
                    _streak = await ProjectService.GetStreakAsync(ProjectId, _currentUserId);
                }
            }
        }
        catch (UnauthorizedAccessException)
        {
            _project = null;
        }
        finally
        {
            _loading = false;
        }
    }

    // Live updates (spec RT2): re-query on a timer and refresh only the display-side
    // state (status, partner, goals, change requests, streak) when the project's
    // signature changes. Deliberately does NOT touch the propose-change form fields
    // (_proposeType/_proposeEndDate/_proposeFrequency) so a partner's
    // action never wipes what the user is typing.
    private async Task RefreshAsync()
    {
        if (_project is null || _actionLoading)
            return;

        try
        {
            var latest = await ProjectService.GetProjectAsync(ProjectId, _currentUserId);
            if (latest is null || ProjectSignature(latest) == ProjectSignature(_project))
                return;

            _project = latest;
            if (latest.Status == Core.Enums.ProjectStatus.Active)
                _streak = await ProjectService.GetStreakAsync(ProjectId, _currentUserId);

            StateHasChanged();
        }
        catch (UnauthorizedAccessException)
        {
            // Participation changed under us; ignore on a background poll.
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to refresh project {ProjectId}", ProjectId);
        }
    }

    private static string ProjectSignature(Core.Entities.Project p) =>
        $"{p.Status}|{p.PartnerId}|{p.Partner?.Name}|{p.EndDate:O}|{p.Frequency}|" +
        string.Join(",", p.Goals.OrderBy(g => g.Id).Select(g => $"{g.Id}:{g.Label}:{string.Join("-", g.Targets.OrderBy(t => t.UserId).Select(t => $"{t.UserId}:{t.TargetValue}:{t.Direction}:{t.Status}"))}")) + "|" +
        string.Join(",", p.ChangeRequests.OrderBy(c => c.Id).Select(c => $"{c.Id}:{c.Status}"));

    private async Task<bool> ConfirmAsync(string title, string message, string action)
    {
        if (_confirmDialog is null)
            return false;

        _confirmTitle = title;
        _confirmMessage = message;
        _confirmAction = action;
        StateHasChanged();

        return await _confirmDialog.ShowAsync();
    }

    private async Task HandleProposeChange()
    {
        await ExecuteAction(async () =>
        {
            _proposeError = null;
            var request = new ProposeChangeRequest { Type = _proposeType };

            if (_proposeType == Core.Enums.ChangeRequestType.EndDate)
                request.NewEndDate = _proposeEndDate;
            else if (_proposeType == Core.Enums.ChangeRequestType.Frequency)
                request.NewFrequency = _proposeFrequency;

            var payloadJson = request.ToPayloadJson();
            await ProjectService.ProposeChangeAsync(ProjectId, _currentUserId, _proposeType, payloadJson);
            _statusMessage = Localizer["ChangeRequestCreatedSuccess"];
            _statusTone = "success";
            _project = await ProjectService.GetProjectAsync(ProjectId, _currentUserId);
        }, ex => _proposeError = ex.Message);
    }

    private async Task HandleRespondToChangeRequest(Guid changeRequestId, bool approve)
    {
        var confirmed = await ConfirmAsync(
            approve ? Localizer["ConfirmApproveTitle"] : Localizer["ConfirmRejectTitle"],
            approve ? Localizer["ConfirmApproveMessage"] : Localizer["ConfirmRejectMessage"],
            approve ? Localizer["ApproveButton"] : Localizer["RejectButton"]);

        if (!confirmed)
            return;

        await ExecuteAction(async () =>
        {
            await ProjectService.RespondToChangeRequestAsync(ProjectId, changeRequestId, _currentUserId, approve);
            _statusMessage = approve ? Localizer["ChangeRequestApprovedSuccess"] : Localizer["ChangeRequestRejectedSuccess"];
            _statusTone = "success";
            _project = await ProjectService.GetProjectAsync(ProjectId, _currentUserId);
        });
    }

    private async Task ExecuteAction(Func<Task> action, Action<Exception>? onError = null)
    {
        _actionLoading = true;
        _statusMessage = null;

        try
        {
            await action();
        }
        catch (GoalValueException ex)
        {
            _statusMessage = GoalValueMessage(ex.Error, ex.GoalLabel, ex.MinValue, ex.MaxValue, ex.DataType);
            _statusTone = "danger";
            onError?.Invoke(ex);
        }
        catch (Exception ex)
        {
            _statusMessage = ex.Message;
            _statusTone = "danger";
            onError?.Invoke(ex);
        }
        finally
        {
            _actionLoading = false;
        }
    }

    private static string StatusTone(Core.Enums.ProjectStatus status) => status switch
    {
        Core.Enums.ProjectStatus.Active => "primary",
        Core.Enums.ProjectStatus.Pending => "partner",
        Core.Enums.ProjectStatus.Cancelled => "destructive",
        _ => "muted"
    };

    private static string CrTone(Core.Enums.ChangeRequestStatus status) => status switch
    {
        Core.Enums.ChangeRequestStatus.Approved => "primary",
        Core.Enums.ChangeRequestStatus.Rejected => "destructive",
        _ => "muted"
    };

    private string GetStatusText(Core.Enums.ProjectStatus status) => status switch
    {
        Core.Enums.ProjectStatus.Pending => Localizer["StatusPending"],
        Core.Enums.ProjectStatus.Active => Localizer["StatusActive"],
        Core.Enums.ProjectStatus.Finished => Localizer["StatusFinished"],
        Core.Enums.ProjectStatus.Cancelled => Localizer["StatusCancelled"],
        _ => status.ToString()
    };

    private string GetFrequencyText(Core.Enums.ProjectFrequency freq) => freq switch
    {
        Core.Enums.ProjectFrequency.Daily => Localizer["FrequencyDaily"],
        Core.Enums.ProjectFrequency.Weekly => Localizer["FrequencyWeekly"],
        Core.Enums.ProjectFrequency.Biweekly => Localizer["FrequencyBiweekly"],
        Core.Enums.ProjectFrequency.Monthly => Localizer["FrequencyMonthly"],
        _ => freq.ToString()
    };

    private string GetChangeRequestTypeText(Core.Enums.ChangeRequestType type) => type switch
    {
        Core.Enums.ChangeRequestType.EndDate => Localizer["ChangeTypeEndDate"],
        Core.Enums.ChangeRequestType.Frequency => Localizer["ChangeTypeFrequency"],
        Core.Enums.ChangeRequestType.Goals => Localizer["ChangeTypeGoals"],
        _ => type.ToString()
    };

    private string GetChangeRequestStatusText(Core.Enums.ChangeRequestStatus status) => status switch
    {
        Core.Enums.ChangeRequestStatus.Pending => Localizer["ChangeRequestStatusPending"],
        Core.Enums.ChangeRequestStatus.Approved => Localizer["ChangeRequestStatusApproved"],
        Core.Enums.ChangeRequestStatus.Rejected => Localizer["ChangeRequestStatusRejected"],
        _ => status.ToString()
    };

    private GoalTarget? GetTargetFor(Core.Entities.GoalField goal, Guid userId)
    {
        return goal.Targets.FirstOrDefault(t => t.UserId == userId);
    }

    private GoalTarget? GetPartnerTargetFor(Core.Entities.GoalField goal)
    {
        if (_project is null)
            return null;

        var partnerId = _project.PartnerId;

        if (_currentUserId != _project.CreatorId)
            partnerId = _project.CreatorId;

        if (partnerId is not null)
            return goal.Targets.FirstOrDefault(t => t.UserId == partnerId);

        // The creator sees the suggested partner target before anyone accepts.
        if (_currentUserId == _project.CreatorId)
            return goal.Targets.FirstOrDefault(t => t.UserId is null);

        return null;
    }

    private string GetDashboardComparePartnerName()
    {
        if (_project is null)
            return Localizer["NoPartnerYet"].Value;

        if (_currentUserId == _project.CreatorId)
            return _project.Partner?.Name ?? Localizer["NoPartnerYet"].Value;

        return _project.Creator?.Name ?? Localizer["NoPartnerYet"].Value;
    }

    private string GetChangeRequestSummary(Core.Entities.ProjectChangeRequest cr)
    {
        if (string.IsNullOrWhiteSpace(cr.PayloadJson))
            return string.Empty;

        try
        {
            return cr.Type switch
            {
                Core.Enums.ChangeRequestType.EndDate => GetEndDateSummary(cr.PayloadJson),
                Core.Enums.ChangeRequestType.Frequency => GetFrequencySummary(cr.PayloadJson),
                Core.Enums.ChangeRequestType.Goals => GetGoalsSummary(cr.PayloadJson),
                _ => string.Empty
            };
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to summarize change request {ChangeRequestId} payload", cr.Id);
            return string.Empty;
        }
    }

    private string GetEndDateSummary(string payloadJson)
    {
        var payload = JsonSerializer.Deserialize<EndDateSummaryPayload>(payloadJson);
        return payload is null
            ? string.Empty
            : Localizer["ChangeRequestSummaryEndDate", payload.EndDate].Value;
    }

    private string GetFrequencySummary(string payloadJson)
    {
        var payload = JsonSerializer.Deserialize<FrequencySummaryPayload>(payloadJson);
        if (payload is null)
            return string.Empty;

        var freqText = GetFrequencyText(payload.Frequency);
        return Localizer["ChangeRequestSummaryFrequency", freqText].Value;
    }

    private string GetGoalsSummary(string payloadJson)
    {
        var payload = JsonSerializer.Deserialize<GoalsSummaryPayload>(payloadJson);
        if (payload is null || payload.Goals is null || payload.Goals.Count == 0)
            return Localizer["ChangeRequestSummaryNoGoals"].Value;

        var lines = new List<string> { Localizer["ChangeRequestSummaryGoals"].Value };

        foreach (var goal in payload.Goals)
        {
            var summary = Localizer["ChangeRequestSummaryGoalLine", goal.Label, "—", goal.Unit ?? string.Empty].Value;

            var dataTypeText = goal.DataType switch
            {
                Core.Enums.GoalDataType.Decimal => Localizer["DataTypeDecimal"].Value,
                Core.Enums.GoalDataType.Integer => Localizer["DataTypeInteger"].Value,
                Core.Enums.GoalDataType.Percent => Localizer["DataTypePercent"].Value,
                Core.Enums.GoalDataType.Boolean => Localizer["DataTypeBoolean"].Value,
                Core.Enums.GoalDataType.Scale => Localizer["DataTypeScale"].Value,
                _ => goal.DataType.ToString()
            };

            var meta = Localizer["ChangeRequestSummaryGoalMeta", dataTypeText, goal.Unit ?? string.Empty].Value;
            summary += $" · {meta}";

            if (goal.MinValue.HasValue && goal.MaxValue.HasValue)
            {
                var range = Localizer["ChangeRequestSummaryGoalRange",
                    DecimalInput.ToDisplay(goal.MinValue, goal.DataType),
                    DecimalInput.ToDisplay(goal.MaxValue, goal.DataType),
                    goal.Unit ?? string.Empty].Value;
                summary += $" · {range}";
            }

            lines.Add(summary);
        }

        return string.Join("\n", lines);
    }

    private string GoalValueMessage(
        GoalValueError error, string label, decimal? min, decimal? max, GoalDataType dataType) => error switch
    {
        GoalValueError.NotInteger => Localizer["GoalValueNotInteger", label],
        GoalValueError.PercentOutOfRange => Localizer["GoalValuePercentOutOfRange", label],
        GoalValueError.BelowMinimum => Localizer["GoalValueBelowMinimum", label, DecimalInput.ToDisplay(min, dataType)],
        GoalValueError.AboveMaximum => Localizer["GoalValueAboveMaximum", label, DecimalInput.ToDisplay(max, dataType)],
        GoalValueError.TargetInconsistentWithDirection => Localizer["GoalValueTargetInconsistent", label],
        GoalValueError.BooleanOutOfRange => Localizer["GoalValueBooleanOutOfRange", label],
        GoalValueError.BooleanInvalidDirection => Localizer["GoalValueBooleanInvalidDirection", label],
        GoalValueError.ScaleInvalidDirection => Localizer["GoalValueScaleInvalidDirection", label],
        GoalValueError.BooleanTargetValueInvalid => Localizer["GoalValueBooleanTargetValueInvalid", label],
        GoalValueError.ScaleBoundsInvalid => Localizer["GoalValueScaleBoundsInvalid", label],
        _ => Localizer["GoalValueInvalid", label]
    };

    public sealed class EndDateSummaryPayload
    {
        public DateTime EndDate { get; set; }
    }

    public sealed class FrequencySummaryPayload
    {
        public Core.Enums.ProjectFrequency Frequency { get; set; }
    }

    public sealed class GoalSummaryItem
    {
        public string Label { get; set; } = string.Empty;
        public Core.Enums.GoalDataType DataType { get; set; }
        public string Unit { get; set; } = string.Empty;
        public decimal? MinValue { get; set; }
        public decimal? MaxValue { get; set; }
    }

    public sealed class GoalsSummaryPayload
    {
        public List<GoalSummaryItem> Goals { get; set; } = new();
    }
}
