<span class="@CssClass" @attributes="AdditionalAttributes">
    @if (Dot)
    {
        <span class="rm-badge__dot"></span>
    }
    @ChildContent
</span>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>primary | partner | muted | outline | destructive</summary>
    [Parameter]
    public string Tone { get; set; } = "primary";

    /// <summary>Leading dot in the badge's own colour.</summary>
    [Parameter]
    public bool Dot { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => string.Join(' ', new[] { "rm-badge", $"rm-badge--{Tone}", Class }
        .Where(c => !string.IsNullOrWhiteSpace(c)));
}
