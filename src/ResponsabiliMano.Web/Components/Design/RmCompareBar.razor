@* Two bars sharing a scale, one per half of the duo. The leader's value is tinted
   so the comparison reads without hunting for the longer bar. *@

<div class="rm-compare @Class">
    <div class="rm-compare__row">
        <div class="rm-compare__track">
            <div class="rm-compare__fill rm-compare__fill--you" style="width: @Percent(YouValue)%"></div>
        </div>
        <span class="rm-compare__value @(YouLeads ? "rm-you-text" : null)">@Format(YouValue)</span>
    </div>
    <div class="rm-compare__row">
        <div class="rm-compare__track">
            <div class="rm-compare__fill rm-compare__fill--partner" style="width: @Percent(PartnerValue)%"></div>
        </div>
        <span class="rm-compare__value @(!YouLeads ? "rm-partner-text" : null)">@Format(PartnerValue)</span>
    </div>
</div>

@code {
    [Parameter]
    public decimal YouValue { get; set; }

    [Parameter]
    public decimal PartnerValue { get; set; }

    /// <summary>Appended to both values, e.g. "kg" or "%".</summary>
    [Parameter]
    public string? Unit { get; set; }

    [Parameter]
    public string? Class { get; set; }

    private bool YouLeads => YouValue >= PartnerValue;

    private decimal Max => Math.Max(Math.Max(YouValue, PartnerValue), 0.0001m);

    private string Percent(decimal value) =>
        (Math.Clamp(value / Max, 0m, 1m) * 100m).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private string Format(decimal value) => $"{value:0.#}{Unit}";
}
