@page "/projects/{ProjectId:guid}/dashboard"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDashboardService DashboardService
@inject IProjectService ProjectService
@inject IFeatureManager FeatureManager
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> Localizer
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject ILogger<Dashboard> Logger
@using Microsoft.FeatureManagement
@implements IAsyncDisposable

<PageTitle>@Localizer["DashboardTitle"]</PageTitle>

@if (_loading)
{
    <div class="skeleton" style="width: 60%; height: 2rem; margin-bottom: 1.5rem;"></div>
    <div class="skeleton" style="width: 100%; height: 24rem; margin-bottom: 1.5rem;"></div>
    <div class="skeleton" style="width: 100%; height: 6rem;"></div>
}
else if (!_available)
{
    <FluentMessageBar Intent="MessageIntent.Error" Title="@Localizer["ProjectNotFound"]" AllowDismiss="false" />
    <FluentButton Appearance="Appearance.Neutral" OnClick="@(() => Navigation.NavigateTo("/"))" Class="mt-3">
        @Localizer["BackToHome"]
    </FluentButton>
}
else if (_error is not null)
{
    <FluentMessageBar Intent="MessageIntent.Error" Title="@_error" AllowDismiss="false" />
    <FluentAnchor Href="@($"/projects/{ProjectId}")" Appearance="Appearance.Neutral" Class="mt-3">
        @Localizer["BackToProject"]
    </FluentAnchor>
}
else if (_dashboard is not null && (!_dashboard.Metrics.Any() || !_dashboard.Participants.Any()))
{
    <h3>@_dashboard.ProjectName — @Localizer["DashboardTitle"]</h3>
    <StreakIndicator CurrentStreak="_streak.Current" BestStreak="_streak.Best" />
    <div class="empty-state">
        <h4 class="empty-state-title">@Localizer["DashboardEmptyTitle"]</h4>
        <p>@Localizer["DashboardEmptyDescription"]</p>
        <FluentAnchor Href="@($"/projects/{ProjectId}")" Appearance="Appearance.Neutral">
            @Localizer["BackToProject"]
        </FluentAnchor>
    </div>
}
else if (_dashboard is not null)
{
    <h3>@_dashboard.ProjectName — @Localizer["DashboardTitle"]</h3>
    <StreakIndicator CurrentStreak="_streak.Current" BestStreak="_streak.Best" />

    @if (_dashboard.Metrics.Count > 1)
    {
        <div class="mb-3" style="max-width: 400px;">
            <FluentSelect TOption="string"
                          Label="@Localizer["DashboardGoalSelector"]"
                          Appearance="Appearance.Outline"
                          Value="_selectedGoalIndex.ToString()"
                          ValueChanged="@OnGoalSelected"
                          Style="width: 100%;">
                @for (var i = 0; i < _dashboard.Metrics.Count; i++)
                {
                    var idx = i;
                    <FluentOption Value="@idx.ToString()">@_dashboard.Metrics[idx].Label (@_dashboard.Metrics[idx].Unit)</FluentOption>
                }
            </FluentSelect>
        </div>
    }

    @if (_dashboard.Metrics.Count > 0)
    {
        <div class="mb-4" style="max-width: 100%;">
            <canvas id="dashboardChart" style="max-height: 400px;"></canvas>
        </div>
    }

    <h4>@Localizer["DashboardFeelingCards"]</h4>
    <div class="row g-3 mb-4">
        @foreach (var participant in _dashboard.Participants)
        {
            <div class="col-12 col-sm-6">
                <FluentCard>
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center">
                        @if (participant.LatestFeeling is not null)
                        {
                            <FeelingFace Feeling="participant.LatestFeeling.Value" Size="40" />
                        }
                        else
                        {
                            <span class="text-muted" style="font-size: 2rem; width: 40px; text-align: center;">—</span>
                        }
                        <div>
                            <strong>@participant.Name</strong>
                            <br />
                            @if (participant.LatestFeeling is not null)
                            {
                                <span class="text-muted">@FeelingText(participant.LatestFeeling.Value)</span>
                            }
                            else
                            {
                                <span class="text-muted">@Localizer["DashboardNoCheckIns"]</span>
                            }
                        </div>
                    </FluentStack>
                </FluentCard>
            </div>
        }
    </div>

    <h4>@Localizer["DashboardAverages"]</h4>
    <div class="row g-3 mb-4">
        @foreach (var metric in _dashboard.Metrics)
        {
            @foreach (var participant in _dashboard.Participants)
            {
                var avg = metric.Series.FirstOrDefault(s => s.UserId == participant.UserId)?.AverageValue;
                <div class="col-12 col-sm-6 col-lg-4">
                    <FluentCard>
                        <h6 style="margin: 0;">@participant.Name — @metric.Label</h6>
                        <p class="card-text" style="font-size: 1.25rem; margin: 0.25rem 0 0 0;">
                            @if (avg is not null)
                            {
                                <span>@avg @metric.Unit</span>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </p>
                    </FluentCard>
                </div>
            }
        }
    </div>

    <FluentAnchor Href="@($"/projects/{ProjectId}")" Appearance="Appearance.Neutral">
        @Localizer["BackToProject"]
    </FluentAnchor>
}

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    private DashboardResponse? _dashboard;
    private bool _loading = true;
    private bool _available = true;
    private string? _error;
    private int _selectedGoalIndex;
    private Guid _currentUserId;
    private (int Current, int Best) _streak;

    protected override async Task OnInitializedAsync()
    {
        if (!await FeatureManager.IsEnabledAsync(FeatureFlags.Dashboard))
        {
            _available = false;
            _loading = false;
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdStr = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userIdStr is null || !Guid.TryParse(userIdStr, out _currentUserId))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            _dashboard = await DashboardService.GetDashboardAsync(ProjectId, _currentUserId);
            if (_dashboard is null)
            {
                _available = false;
            }
            else
            {
                try
                {
                    _streak = await ProjectService.GetStreakAsync(ProjectId, _currentUserId);
                }
                catch
                {
                    _streak = (0, 0);
                }
            }
        }
        catch (UnauthorizedAccessException)
        {
            _available = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load dashboard for project {ProjectId}", ProjectId);
            _error = Localizer["DashboardError"];
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _dashboard is not null && _available && _error is null)
        {
            await RenderChartAsync();
        }
    }

    private async Task OnGoalSelected(string? value)
    {
        if (int.TryParse(value, out var index))
        {
            _selectedGoalIndex = index;
            await RenderChartAsync();
        }
    }

    private async Task RenderChartAsync()
    {
        if (_dashboard is null || _dashboard.Metrics.Count == 0) return;
        var config = BuildChartConfig(_selectedGoalIndex);
        await JS.InvokeVoidAsync("dashboardChart.render", "dashboardChart", config);
    }

    private object BuildChartConfig(int goalIndex)
    {
        var metric = _dashboard!.Metrics[goalIndex];

        var allPeriods = metric.Series
            .Select(s => s.PeriodNumber)
            .Distinct()
            .OrderBy(p => p)
            .ToList();

        var datasets = new List<object>();
        var colors = new[]
        {
            "rgb(232, 93, 78)",
            "rgb(91, 146, 121)",
            "rgb(45, 157, 120)",
            "rgb(244, 162, 97)"
        };

        for (var i = 0; i < _dashboard.Participants.Count; i++)
        {
            var participant = _dashboard.Participants[i];
            var entries = metric.Series
                .Where(s => s.UserId == participant.UserId)
                .OrderBy(s => s.PeriodNumber)
                .ToList();

            var data = allPeriods.Select(period =>
            {
                var entry = entries.FirstOrDefault(e => e.PeriodNumber == period);
                return entry is not null ? (object?)entry.Value : null;
            }).ToList();

            datasets.Add(new
            {
                label = participant.Name,
                data = data,
                borderColor = colors[i % colors.Length],
                tension = 0.1,
                fill = false
            });
        }

        return new
        {
            type = "line",
            data = new
            {
                labels = allPeriods.Select(p => (object)p).ToList(),
                datasets = datasets
            },
            options = new
            {
                responsive = true,
                maintainAspectRatio = false,
                scales = new
                {
                    x = new { title = new { display = true, text = Localizer["DashboardPeriodAxis"].ToString() } },
                    y = new { title = new { display = true, text = Localizer["DashboardValueAxis"].ToString() } }
                }
            }
        };
    }

    private string FeelingText(Feeling feeling) => feeling switch
    {
        Feeling.VerySad => Localizer["FeelingVerySad"],
        Feeling.Sad => Localizer["FeelingSad"],
        Feeling.Neutral => Localizer["FeelingNeutral"],
        Feeling.Happy => Localizer["FeelingHappy"],
        Feeling.VeryHappy => Localizer["FeelingVeryHappy"],
        _ => feeling.ToString()
    };

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("dashboardChart.destroy");
        }
        catch
        {
        }
    }
}
