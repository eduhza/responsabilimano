@page "/projects/{ProjectId:guid}/dashboard"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDashboardService DashboardService
@inject IProjectService ProjectService
@inject IFeatureManager FeatureManager
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> Localizer
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject ILogger<Dashboard> Logger
@using Microsoft.FeatureManagement
@implements IAsyncDisposable

<PageTitle>@Localizer["ProjectDashboardTitle"]</PageTitle>

@if (_loading)
{
    <div class="skeleton dash__skeleton dash__skeleton--head"></div>
    <div class="skeleton dash__skeleton dash__skeleton--chart"></div>
}
else if (!_available)
{
    <RmAlert Tone="danger">@Localizer["ProjectNotFound"]</RmAlert>
    <RmButton Href="/projects" Variant="outline" Class="mt-3">@Localizer["BackToHome"]</RmButton>
}
else if (_error is not null)
{
    <RmAlert Tone="danger">@_error</RmAlert>
    <RmButton Href="@($"/projects/{ProjectId}")" Variant="outline" Class="mt-3">@Localizer["BackToProject"]</RmButton>
}
else if (_dashboard is not null)
{
    <AutoRefresh IntervalSeconds="5" OnRefresh="RefreshAsync" />

    @* Labelled explicitly: the visible text is the project name, so the action itself
       only reads as "back to the project" to a screen reader without this. *@
    <a href="@($"/projects/{ProjectId}")" class="rm-back-link" aria-label="@Localizer["BackToProject"]">
        <RmIcon Name="arrow-left" Size="0.875rem" />
        @_dashboard.ProjectName
    </a>

    <div class="dash__head">
        <div>
            <h1 class="dash__title">@Localizer["ProjectDashboardTitle"]</h1>
            @* Scoped to this project only: the account-wide numbers live on /dashboard. *@
            <p class="dash__subtitle">
                @_dashboard.ProjectName
                @if (_dashboard.CurrentPeriod > 0 && _dashboard.TotalPeriods > 0)
                {
                    <span> · @Localizer["ProjectDashboardProgress", Math.Min(_dashboard.CurrentPeriod, _dashboard.TotalPeriods), _dashboard.TotalPeriods]</span>
                }
            </p>
        </div>
        <div class="dash__legend">
            @for (var i = 0; i < _dashboard.Participants.Count; i++)
            {
                <span>
                    <span class="dash__legend-dot @(i == 0 ? "dash__legend-dot--you" : "dash__legend-dot--partner")"></span>
                    @_dashboard.Participants[i].Name
                </span>
            }
        </div>
    </div>

    @if (!_dashboard.Metrics.Any() || !_dashboard.Participants.Any())
    {
        <RmEmptyState Icon="trending-up"
                      Title="@Localizer["DashboardEmptyTitle"]"
                      Description="@Localizer["DashboardEmptyDescription"]">
            <RmButton Href="@($"/projects/{ProjectId}")" Variant="outline">@Localizer["BackToProject"]</RmButton>
        </RmEmptyState>
    }
    else
    {
        @* Averages first: a side-by-side read of where the pair stands, before the
           period-by-period detail. *@
        <h2 class="dash__section dash__section--first">@Localizer["DashboardAverages"]</h2>
        <div class="dash__stats">
            @foreach (var metric in _dashboard.Metrics)
            {
                var cv = Compare(metric);
                var label = string.IsNullOrWhiteSpace(metric.Unit)
                    ? metric.Label
                    : $"{metric.Label} ({metric.Unit})";
                <RmStatCard Label="@label" Icon="target">
                    <RmCompareBar YouProgress="@cv.YouProgress"
                                  PartnerProgress="@cv.PartnerProgress"
                                  YouValue="@cv.YouValue"
                                  PartnerValue="@cv.PartnerValue"
                                  DataType="metric.DataType"
                                  Unit="metric.Unit"
                                  MinValue="metric.MinValue"
                                  MaxValue="metric.MaxValue" />
                </RmStatCard>
            }

            <RmStatCard Label="@Localizer["StreakDays"]" Icon="flame" Highlight="true">
                <div>
                    <p class="dash__streak-value rm-display">@_streak.Current</p>
                    <p class="dash__streak-caption">@Localizer["StreakBest", _streak.Best]</p>
                </div>
            </RmStatCard>
        </div>

        <RmCard Class="dash__chart-card">
            <div class="dash__chart-head">
                <div>
                    <h2 class="dash__chart-title">@_dashboard.Metrics[_selectedGoalIndex].Label</h2>
                    <p class="dash__chart-sub">@Localizer["DashboardPeriodAxis"] · @_dashboard.Metrics[_selectedGoalIndex].Unit</p>
                </div>

                @if (_dashboard.Metrics.Count > 1)
                {
                    <div class="rm-segmented" role="group" aria-label="@Localizer["DashboardGoalSelector"]">
                        @for (var i = 0; i < _dashboard.Metrics.Count; i++)
                        {
                            var idx = i;
                            <button type="button" class="rm-segmented__item"
                                    aria-pressed="@(_selectedGoalIndex == idx)"
                                    @onclick="() => OnGoalSelected(idx)">
                                @_dashboard.Metrics[idx].Label
                            </button>
                        }
                    </div>
                }
            </div>

            <div class="dash__chart">
                <canvas id="dashboardChart"></canvas>
            </div>
        </RmCard>

        <h2 class="dash__section">@Localizer["DashboardFeelingCards"]</h2>
        <div class="dash__moods">
            @foreach (var participant in _dashboard.Participants)
            {
                <RmCard Flat="true" Class="mood">
                    @if (participant.LatestFeeling is not null)
                    {
                        <FeelingFace Feeling="participant.LatestFeeling.Value" Size="44" />
                    }
                    else
                    {
                        <span class="mood__none">—</span>
                    }
                    <div>
                        <p class="mood__name">@participant.Name</p>
                        <p class="mood__label">
                            @(participant.LatestFeeling is not null
                                ? FeelingText(participant.LatestFeeling.Value)
                                : Localizer["DashboardNoCheckIns"].Value)
                        </p>
                    </div>
                </RmCard>
            }
        </div>
    }
}

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    private DashboardResponse? _dashboard;
    private bool _loading = true;
    private bool _available = true;
    private string? _error;
    private int _selectedGoalIndex;
    private Guid _currentUserId;
    private (int Current, int Best) _streak;
    private bool _pendingChartRender;

    protected override async Task OnInitializedAsync()
    {
        if (!await FeatureManager.IsEnabledAsync(FeatureFlags.Dashboard))
        {
            _available = false;
            _loading = false;
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdStr = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userIdStr is null || !Guid.TryParse(userIdStr, out _currentUserId))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            _dashboard = await DashboardService.GetDashboardAsync(ProjectId, _currentUserId);
            if (_dashboard is null)
            {
                _available = false;
            }
            else
            {
                try
                {
                    _streak = await ProjectService.GetStreakAsync(ProjectId, _currentUserId);
                }
                catch
                {
                    _streak = (0, 0);
                }
            }
        }
        catch (UnauthorizedAccessException)
        {
            _available = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load dashboard for project {ProjectId}", ProjectId);
            _error = Localizer["DashboardError"];
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _dashboard is not null && _available && _error is null)
        {
            await RenderChartAsync();
        }
        else if (_pendingChartRender)
        {
            _pendingChartRender = false;
            await RenderChartAsync();
        }
    }

    // Live updates (spec RT2): re-query on a timer and refresh only when the check-in
    // data or feelings changed, re-rendering the chart on the next render cycle so a
    // partner's new check-in appears without a manual reload.
    private async Task RefreshAsync()
    {
        if (!_available || _loading)
            return;

        try
        {
            var latest = await DashboardService.GetDashboardAsync(ProjectId, _currentUserId);
            if (latest is null)
                return;

            if (_dashboard is not null && DashboardSignature(latest) == DashboardSignature(_dashboard))
                return;

            _dashboard = latest;

            try
            {
                _streak = await ProjectService.GetStreakAsync(ProjectId, _currentUserId);
            }
            catch
            {
                _streak = (0, 0);
            }

            if (_selectedGoalIndex >= _dashboard.Metrics.Count)
                _selectedGoalIndex = 0;

            _pendingChartRender = _dashboard.Metrics.Any() && _dashboard.Participants.Any();
            StateHasChanged();
        }
        catch (UnauthorizedAccessException)
        {
            // Participation changed; ignore on a background poll.
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to refresh dashboard for project {ProjectId}", ProjectId);
        }
    }

    private static string DashboardSignature(DashboardResponse d) =>
        string.Join("|", d.Participants.Select(p => $"{p.UserId}:{p.LatestFeeling}")) + "||" +
        string.Join("|", d.Metrics.Select(m =>
            $"{m.GoalFieldId}:{string.Join(",", m.Series.Select(s => $"{s.UserId}/{s.PeriodNumber}/{s.Value}"))}"));

    private async Task OnGoalSelected(int index)
    {
        _selectedGoalIndex = index;
        await RenderChartAsync();
    }

    private sealed record CompareValues(
        decimal? YouProgress,
        decimal? PartnerProgress,
        decimal? YouValue,
        decimal? PartnerValue);

    private CompareValues Compare(DashboardMetricSeries metric)
    {
        if (_dashboard is null)
            return new CompareValues(null, null, null, null);

        var youUserId = _currentUserId;
        var partnerUserId = _dashboard.Participants
            .FirstOrDefault(p => p.UserId != _currentUserId)?.UserId;

        var (youProgress, youValue) = ProgressFor(metric, youUserId);
        var (partnerProgress, partnerValue) = ProgressFor(metric, partnerUserId);

        return new CompareValues(youProgress, partnerProgress, youValue, partnerValue);
    }

    private (decimal? Progress, decimal? Value) ProgressFor(DashboardMetricSeries metric, Guid? userId)
    {
        if (userId is null)
            return (null, null);

        var target = metric.Targets.FirstOrDefault(t => t.UserId == userId);
        var average = metric.Series.FirstOrDefault(s => s.UserId == userId)?.AverageValue;

        if (average is null)
            return (null, null);

        var firstCheckIn = metric.Series
            .Where(s => s.UserId == userId)
            .OrderBy(s => s.PeriodNumber)
            .Select(s => (decimal?)s.Value)
            .FirstOrDefault();

        var progress = GoalProgress.Percent(
            target?.Baseline,
            average.Value,
            target?.TargetValue,
            target?.Direction ?? GoalDirection.Reach,
            firstCheckIn);

        return (progress, average.Value);
    }

    private async Task RenderChartAsync()
    {
        if (_dashboard is null || _dashboard.Metrics.Count == 0) return;
        var config = BuildChartConfig(_selectedGoalIndex);
        await JS.InvokeVoidAsync("dashboardChart.render", "dashboardChart", config);
    }

    private object BuildChartConfig(int goalIndex)
    {
        var metric = _dashboard!.Metrics[goalIndex];

        var allPeriods = metric.Series
            .Select(s => s.PeriodNumber)
            .Distinct()
            .OrderBy(p => p)
            .ToList();

        var datasets = new List<object>();
        // Token names, not literals: dashboard.js resolves them so the series follow the
        // you/partner pair and re-tint with the theme.
        var colorTokens = new[] { "--rm-you", "--rm-partner", "--rm-chart-3", "--rm-chart-4" };

        for (var i = 0; i < _dashboard.Participants.Count; i++)
        {
            var participant = _dashboard.Participants[i];
            var entries = metric.Series
                .Where(s => s.UserId == participant.UserId)
                .OrderBy(s => s.PeriodNumber)
                .ToList();

            var data = allPeriods.Select(period =>
            {
                var entry = entries.FirstOrDefault(e => e.PeriodNumber == period);
                return entry is not null ? (object?)entry.Value : null;
            }).ToList();

            datasets.Add(new
            {
                label = participant.Name,
                data = data,
                colorToken = colorTokens[i % colorTokens.Length],
                tension = 0.3,
                borderWidth = 2.5,
                fill = false
            });
        }

        var (yMin, yMax) = ChartRange(metric);
        var yScale = new Dictionary<string, object?>
        {
            ["title"] = new { display = true, text = Localizer["DashboardValueAxis"].ToString() }
        };
        if (yMin is not null) yScale["min"] = yMin;
        if (yMax is not null) yScale["max"] = yMax;

        return new
        {
            type = "line",
            data = new
            {
                labels = allPeriods.Select(p => (object)p).ToList(),
                datasets = datasets
            },
            options = new
            {
                responsive = true,
                maintainAspectRatio = false,
                scales = new
                {
                    x = new { title = new { display = true, text = Localizer["DashboardPeriodAxis"].ToString() } },
                    y = yScale
                }
            }
        };
    }

    private static (decimal? Min, decimal? Max) ChartRange(DashboardMetricSeries metric) => metric.DataType switch
    {
        GoalDataType.Boolean => (0m, 1m),
        GoalDataType.Percent => (0m, 100m),
        GoalDataType.Scale when metric.MinValue is not null && metric.MaxValue is not null => (metric.MinValue, metric.MaxValue),
        _ when metric.MinValue is not null && metric.MaxValue is not null => (metric.MinValue, metric.MaxValue),
        _ => (null, null)
    };

    private string FeelingText(Feeling feeling) => feeling switch
    {
        Feeling.VerySad => Localizer["FeelingVerySad"],
        Feeling.Sad => Localizer["FeelingSad"],
        Feeling.Neutral => Localizer["FeelingNeutral"],
        Feeling.Happy => Localizer["FeelingHappy"],
        Feeling.VeryHappy => Localizer["FeelingVeryHappy"],
        _ => feeling.ToString()
    };

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("dashboardChart.destroy");
        }
        catch
        {
        }
    }
}
