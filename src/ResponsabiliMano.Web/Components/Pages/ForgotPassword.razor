@page "/forgot-password"
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@layout AuthLayout
@inject IPasswordResetService ResetService
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> Localizer
@inject ILogger<ForgotPassword> Logger

<PageTitle>@Localizer["ForgotPasswordTitle"]</PageTitle>

<div>
    <h1 class="auth-form__title">@Localizer["ForgotPasswordTitle"]</h1>
    <p class="auth-form__subtitle">@Localizer["ForgotPasswordSubtitle"]</p>

    @if (_submitted)
    {
        <RmAlert Tone="success" Class="auth-form__alert">@Localizer["ForgotPasswordSent"]</RmAlert>
    }
    else
    {
        <EditForm Model="_model" OnValidSubmit="HandleSubmit" FormName="forgotPasswordForm" class="auth-form">
            <DataAnnotationsValidator />

            <RmField Label="@Localizer["EmailLabel"]" For="email">
                <InputText id="email" type="email" class="rm-input" @bind-Value="_model.Email"
                           placeholder="@EmailPlaceholder" />
                <ValidationMessage For="@(() => _model.Email)" />
            </RmField>

            @if (!string.IsNullOrEmpty(_error))
            {
                <RmAlert Tone="danger">@_error</RmAlert>
            }

            <button type="submit" class="rm-btn rm-btn--primary rm-btn--block" disabled="@_isLoading">
                @(_isLoading ? Localizer["Sending"] : Localizer["SendResetLinkButton"])
            </button>
        </EditForm>
    }

    <p class="auth-form__footer">
        <a href="/login" class="auth-form__link">@Localizer["BackToLogin"]</a>
    </p>
</div>

@code {
    // Literal in C# rather than the markup: Razor reads a bare @ in an attribute
    // value as the start of an expression.
    private const string EmailPlaceholder = "voce@email.com";

    private ForgotPasswordRequest _model = new();
    private string? _error;
    private bool _isLoading;
    private bool _submitted;

    private async Task HandleSubmit()
    {
        _isLoading = true;
        _error = null;

        try
        {
            await ResetService.RequestResetAsync(_model.Email, Navigation.BaseUri);
            _submitted = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to request password reset");
            _error = Localizer["ForgotPasswordError"];
        }
        finally
        {
            _isLoading = false;
        }
    }
}
