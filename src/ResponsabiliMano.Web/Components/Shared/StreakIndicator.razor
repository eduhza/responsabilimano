@inject IStringLocalizer<AppStrings> Localizer

<div class="streak-container">
    <span class="streak-flame @(CurrentStreak > 0 ? "active" : "inactive")" aria-hidden="true">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 22c4.97 0 9-4.03 9-9-1.5 0-2.5-.5-3.2-1.3-.5-.6-.8-1.3-.8-2.1 0-1.6 1-2.6 2.2-3.4-.4-.8-1-1.6-1.8-2.2-.9-.7-2-1.1-3.2-1.2.2.8.3 1.5.3 2.3 0 1.8-.7 3.4-1.9 4.6-1.2 1.3-2.8 2-4.6 2-.8 0-1.6-.1-2.3-.4.1 1.2.5 2.3 1.2 3.2.6.8 1.4 1.4 2.2 1.8-.8 1.2-1.8 2.2-3.4 2.2-.8 0-1.5-.3-2.1-.8-.8-.7-1.3-1.7-1.3-3.2C3 13.97 7.03 22 12 22z" />
        </svg>
    </span>
    <span class="streak-number">@CurrentStreak</span>
    <span class="streak-text">
        <span class="streak-label">@Localizer["StreakDays"]</span>
        <span class="streak-best">@Localizer["StreakBest", BestStreak]</span>
    </span>
</div>

@code {
    [Parameter] public int CurrentStreak { get; set; }
    [Parameter] public int BestStreak { get; set; }
}
