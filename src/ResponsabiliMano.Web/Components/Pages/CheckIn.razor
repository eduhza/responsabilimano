@page "/projects/{ProjectId:guid}/checkin"
@rendermode InteractiveServer
@attribute [Authorize]
@inject ICheckInService CheckInService
@inject IFeatureManager FeatureManager
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> Localizer
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<CheckIn> Logger
@using Microsoft.FeatureManagement

<PageTitle>@Localizer["CheckInTitle"]</PageTitle>

@if (_loading)
{
    <div class="skeleton checkin__skeleton checkin__skeleton--head"></div>
    <div class="skeleton checkin__skeleton checkin__skeleton--body"></div>
}
else if (!_available || _form is null)
{
    <RmAlert Tone="danger">@Localizer["ProjectNotFound"]</RmAlert>
    <RmButton Href="/projects" Variant="outline" Class="mt-3">@Localizer["BackToHome"]</RmButton>
}
else if (_form.PeriodNumber < 1)
{
    <RmAlert Tone="danger">@Localizer["ProjectNotFound"]</RmAlert>
    <RmButton Href="/projects" Variant="outline" Class="mt-3">@Localizer["BackToHome"]</RmButton>
}
else
{
    <a href="@($"/projects/{ProjectId}")" class="rm-back-link">
        <RmIcon Name="arrow-left" Size="0.875rem" />
        @_form.Project.Name
    </a>

    <h1 class="checkin__title">@Localizer["CheckInTitle"]</h1>

    <CheckInEditor Form="_form" UserId="_currentUserId" SuccessButtonLabel="@Localizer["BackToProject"]" OnSubmitted="OnSubmitted" />
}

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    private CheckInForm? _form;
    private bool _available = true;
    private bool _loading = true;
    private Guid _currentUserId;

    protected override async Task OnInitializedAsync()
    {
        if (!await FeatureManager.IsEnabledAsync(FeatureFlags.CheckIns))
        {
            _available = false;
            _loading = false;
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdStr = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userIdStr is null || !Guid.TryParse(userIdStr, out _currentUserId))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            _form = await CheckInService.GetCheckInFormAsync(ProjectId, _currentUserId);
            if (_form is null)
            {
                _available = false;
            }
        }
        catch (UnauthorizedAccessException)
        {
            _available = false;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSubmitted()
    {
        if (_form is null)
            return;

        try
        {
            _form = await CheckInService.GetCheckInFormAsync(ProjectId, _currentUserId);
        }
        catch (UnauthorizedAccessException)
        {
            _available = false;
        }
    }
}
