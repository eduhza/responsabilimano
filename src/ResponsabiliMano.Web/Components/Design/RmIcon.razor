@* Inline SVG icons (Lucide, ISC). Kept in one switch so we neither ship an icon
   package nor scatter raw <svg> markup across the pages. *@

<svg xmlns="http://www.w3.org/2000/svg"
     viewBox="0 0 24 24"
     fill="none"
     stroke="currentColor"
     stroke-width="@StrokeWidth"
     stroke-linecap="round"
     stroke-linejoin="round"
     width="@Size"
     height="@Size"
     class="@($"rm-icon {Class}".Trim())"
     aria-hidden="true"
     focusable="false">
    @((MarkupString)Path(Name))
</svg>

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = default!;

    /// <summary>Rendered size in CSS units. Matches the surrounding text by default.</summary>
    [Parameter]
    public string Size { get; set; } = "1em";

    [Parameter]
    public string StrokeWidth { get; set; } = "2";

    [Parameter]
    public string? Class { get; set; }

