@page "/projects/{ProjectId:guid}/checkin"
@rendermode InteractiveServer
@attribute [Authorize]
@inject ICheckInService CheckInService
@inject IFeatureManager FeatureManager
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> Localizer
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<CheckIn> Logger
@using Microsoft.FeatureManagement
@using ResponsabiliMano.Core.Entities

<PageTitle>@Localizer["CheckInTitle"]</PageTitle>

@if (_loading)
{
    <div class="skeleton checkin__skeleton checkin__skeleton--head"></div>
    <div class="skeleton checkin__skeleton checkin__skeleton--body"></div>
}
else if (!_available || _project is null)
{
    <RmAlert Tone="danger">@Localizer["ProjectNotFound"]</RmAlert>
    <RmButton Href="/projects" Variant="outline" Class="mt-3">@Localizer["BackToHome"]</RmButton>
}
else if (_success || _alreadySubmitted)
{
    <RmEmptyState Icon="check-circle"
                  Title="@(_success ? Localizer["CheckInSuccess"].Value : Localizer["CheckInAlreadyDone"].Value)">
        <RmButton Href="@($"/projects/{ProjectId}")" Variant="outline">@Localizer["BackToProject"]</RmButton>
    </RmEmptyState>
}
else
{
    <a href="@($"/projects/{ProjectId}")" class="rm-back-link">
        <RmIcon Name="arrow-left" Size="0.875rem" />
        @_project.Name
    </a>

    <h1 class="checkin__title">@Localizer["CheckInTitle"]</h1>
    <p class="checkin__subtitle">@Localizer["CheckInPeriodLabel", _period]</p>

    <h2 class="checkin__section">@Localizer["CheckInMetricsTitle"]</h2>
    <div class="checkin__metrics">
        @foreach (var entry in _metrics)
        {
            <RmCard Flat="true" Class="metric">
                <RmField Label="@entry.Goal.Label">
                    <Hint>
                        @entry.Goal.Unit
                        @if (entry.Goal.MinValue is not null || entry.Goal.MaxValue is not null)
                        {
                            <text> · @entry.Goal.MinValue?.ToString("0.##") … @entry.Goal.MaxValue?.ToString("0.##")</text>
                        }
                        @if (entry.Goal.TargetValue is not null)
                        {
                            <text> · @Localizer["GoalTargetValueLabel"]: @entry.Goal.TargetValue?.ToString("0.##")</text>
                        }
                    </Hint>
                    <ChildContent>
                        <input type="number" step="any" class="rm-input rm-tabular"
                               min="@entry.Goal.MinValue?.ToString("0.##")"
                               max="@entry.Goal.MaxValue?.ToString("0.##")"
                               value="@entry.Value"
                               @onchange="e => entry.Value = decimal.TryParse(e.Value?.ToString(), out var v) ? v : null" />
                    </ChildContent>
                </RmField>
            </RmCard>
        }
    </div>

    <h2 class="checkin__section">@Localizer["CheckInFeelingTitle"]</h2>
    <RmCard Class="checkin__feelings">
        <div class="feeling-selector" role="radiogroup" aria-label="@Localizer["CheckInFeelingTitle"]">
            @foreach (var feeling in Feelings)
            {
                var current = feeling;
                <button type="button"
                        class="feeling-button @(_feeling == current ? "selected" : string.Empty)"
                        aria-pressed="@(_feeling == current)"
                        title="@FeelingText(current)"
                        @onclick="() => _feeling = current">
                    <FeelingFace Feeling="current" Size="44" />
                    <span class="feeling-label">@FeelingText(current)</span>
                </button>
            }
        </div>
    </RmCard>

    @if (!string.IsNullOrEmpty(_error))
    {
        <RmAlert Tone="danger" Class="mt-3">@_error</RmAlert>
    }

    <div class="checkin__actions">
        <RmButton Href="@($"/projects/{ProjectId}")" Variant="outline">@Localizer["Cancel"]</RmButton>
        <RmButton Disabled="_submitting" @onclick="HandleSubmit">
            @(_submitting ? Localizer["Processing"] : Localizer["CheckInSubmitButton"])
        </RmButton>
    </div>
}

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    private static readonly Feeling[] Feelings =
        [Feeling.VerySad, Feeling.Sad, Feeling.Neutral, Feeling.Happy, Feeling.VeryHappy];

    private Project? _project;
    private int _period;
    private bool _available = true;
    private bool _loading = true;
    private bool _alreadySubmitted;
    private bool _submitting;
    private bool _success;
    private string? _error;
    private Feeling _feeling = Feeling.Neutral;
    private readonly List<MetricEntry> _metrics = new();
    private Guid _currentUserId;

    protected override async Task OnInitializedAsync()
    {
        if (!await FeatureManager.IsEnabledAsync(FeatureFlags.CheckIns))
        {
            _available = false;
            _loading = false;
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdStr = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userIdStr is null || !Guid.TryParse(userIdStr, out _currentUserId))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            var form = await CheckInService.GetCheckInFormAsync(ProjectId, _currentUserId);
            if (form is null || form.PeriodNumber < 1)
            {
                _available = false;
                return;
            }

            _project = form.Project;
            _period = form.PeriodNumber;
            _alreadySubmitted = form.AlreadySubmitted;
            _metrics.AddRange(form.Project.Goals.Select(g => new MetricEntry(g)));
        }
        catch (UnauthorizedAccessException)
        {
            _available = false;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandleSubmit()
    {
        _submitting = true;
        _error = null;

        try
        {
            if (_metrics.Any(m => m.Value is null))
            {
                _error = Localizer["CheckInMissingValues"];
                return;
            }

            var metrics = _metrics
                .Select(m => new CheckInMetricInput(m.Goal.Id, m.Value!.Value))
                .ToList();

            await CheckInService.SubmitCheckInAsync(ProjectId, _currentUserId, _feeling, metrics);
            _success = true;
        }
        catch (ArgumentException ex)
        {
            _error = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to submit check-in for project {ProjectId}", ProjectId);
            _error = Localizer["CheckInError"];
        }
        finally
        {
            _submitting = false;
        }
    }

    private string FeelingText(Feeling feeling) => feeling switch
    {
        Feeling.VerySad => Localizer["FeelingVerySad"],
        Feeling.Sad => Localizer["FeelingSad"],
        Feeling.Neutral => Localizer["FeelingNeutral"],
        Feeling.Happy => Localizer["FeelingHappy"],
        Feeling.VeryHappy => Localizer["FeelingVeryHappy"],
        _ => feeling.ToString()
    };

    private sealed class MetricEntry
    {
        public MetricEntry(GoalField goal) => Goal = goal;
        public GoalField Goal { get; }
        public decimal? Value { get; set; }
    }
}
