@inject IStringLocalizer<AppStrings> Localizer

<div class="nav-brand">
    <a class="app-title" href="">@Localizer["AppTitle"]</a>
</div>

<FluentNavMenu Width="240" Collapsible="false" Title="@Localizer["NavHome"]" Class="nav-menu">
    <AuthorizeView>
        <Authorized>
            <FluentNavLink Href="/" Icon="@(new Icons.Regular.Size20.Home())" Match="NavLinkMatch.All">
                @Localizer["NavHome"]
            </FluentNavLink>

            <FluentNavLink Href="/projects/new" Icon="@(new Icons.Regular.Size20.Add())">
                @Localizer["NavCreateProject"]
            </FluentNavLink>

            <form method="post" action="api/auth/logout" class="logout-form">
                <button type="submit" class="nav-link-button">
                    <FluentIcon Value="@(new Icons.Regular.Size20.SignOut())" />
                    <span>@Localizer["LogoutButton"]</span>
                </button>
            </form>
        </Authorized>
        <NotAuthorized>
            <FluentNavLink Href="/login" Icon="@(new Icons.Regular.Size20.ArrowEnter())">
                @Localizer["LoginButton"]
            </FluentNavLink>

            <FluentNavLink Href="/register" Icon="@(new Icons.Regular.Size20.PersonAdd())">
                @Localizer["RegisterButton"]
            </FluentNavLink>
        </NotAuthorized>
    </AuthorizeView>
</FluentNavMenu>

